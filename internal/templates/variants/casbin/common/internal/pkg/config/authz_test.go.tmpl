package config

import (
 "encoding/base64"
 "os"
 "path/filepath"
 "testing"
)

func TestAuthorizationConfiguration(t *testing.T){
 [[if eq .Transport "grpc"]]t.Setenv("APP_ENV","development")[[end]]
 t.Setenv("APP_JWT_SECRET",base64.StdEncoding.EncodeToString(make([]byte,32)))
 [[if or (eq .Database "mysql") (eq .Database "postgres")]]t.Setenv("APP_DATABASE_PASSWORD","test-placeholder")[[end]]
 [[if .Redis]]t.Setenv("APP_REDIS_PASSWORD","test-placeholder")[[end]]
 path:=filepath.Join(t.TempDir(),"app.yaml")
 [[if eq .Database "none"]]
 for _,data:=range []string{"authz:\n  policy_file: ''\n","authz:\n  policy_file: 1\n","authz:\n  policy_file: '   '\n","authz:\n  unknown: true\n"}{if err:=os.WriteFile(path,[]byte(data),0600);err!=nil{t.Fatal(err)};if _,err:=Load(path,true,Overrides{});err==nil{t.Fatal("invalid policy configuration accepted")}}
 if err:=os.WriteFile(path,[]byte("{}\n"),0600);err!=nil{t.Fatal(err)};settings,err:=Load(path,true,Overrides{});if err!=nil||settings.Authz.PolicyFile!="configs/policy.csv"{t.Fatal("default policy path")}
 t.Setenv("APP_AUTHZ_POLICY_FILE","custom/policy.csv");settings,err=Load(path,true,Overrides{});if err!=nil||settings.Authz.PolicyFile!="custom/policy.csv"{t.Fatal("policy environment binding")}
 [[else]]if err:=os.WriteFile(path,[]byte("authz:\n  policy_file: policy.csv\n"),0600);err!=nil{t.Fatal(err)};if _,err:=Load(path,true,Overrides{});err==nil{t.Fatal("file policy config leaked into SQL mode")}[[end]]
}
