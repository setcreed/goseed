// Package gateway serves HTTP through the authenticated RPC service.
package gateway

import (
 "context"
 "crypto/tls"
 "crypto/x509"
 "errors"
 "net"
 "os"
 "time"

 "[[.Module]]/internal/pkg/config"
 "[[.Module]]/internal/pkg/rpc"
 "[[.Module]]/internal/pkg/server"
 [[if .Observability]]"[[.Module]]/internal/pkg/observability"[[end]]
 "go.uber.org/zap"
 "google.golang.org/grpc"
 "google.golang.org/grpc/credentials"
 "google.golang.org/grpc/credentials/insecure"
 healthpb "google.golang.org/grpc/health/grpc_health_v1"
)

type Server struct { settings config.Config; rpc *rpc.Server; logger *zap.Logger; modules []Registration[[if .Metrics]];metrics *observability.Metrics[[end]][[if .Tracing]];tracing *observability.Tracing[[end]] }
func New(settings config.Config, service *rpc.Server, logger *zap.Logger, modules []Registration[[if .Observability]],telemetry ...any[[end]])*Server{server:=&Server{settings:settings,rpc:service,logger:logger,modules:modules};[[if .Observability]]for _,item:=range telemetry{[[if .Metrics]]if value,ok:=item.(*observability.Metrics);ok{server.metrics=value};[[end]][[if .Tracing]]if value,ok:=item.(*observability.Tracing);ok{server.tracing=value}[[end]]}[[end]];return server}

func(s *Server)Run(ctx context.Context)error{
 if err:=ctx.Err();err!=nil{s.rpc.Stop();return err}
 httpListener,err:=net.Listen("tcp",s.settings.HTTP.Address)
 if err!=nil{s.rpc.Stop();return errors.New("cannot listen on configured HTTP address")}
 grpcListener,err:=net.Listen("tcp",s.settings.GRPC.Address)
 if err!=nil{_ = httpListener.Close();s.rpc.Stop();return errors.New("cannot listen on configured gRPC address")}
 return s.Serve(ctx,httpListener,grpcListener)
}

// Listeners and the forwarding connection belong to this call. The RPC
// lifetime is independent of HTTP cancellation so in-flight forwarding drains.
func(s *Server)Serve(ctx context.Context,httpListener,grpcListener net.Listener)error{
 defer func(){_ = httpListener.Close();_ = grpcListener.Close()}()
 connection,err:=s.connect(grpcListener.Addr().String())
 if err!=nil{s.rpc.Stop();return err}
 defer func(){_ = connection.Close()}()
 ready:=&server.Readiness{CheckDependency:func(ctx context.Context)error{
  response,err:=healthpb.NewHealthClient(connection).Check(ctx,&healthpb.HealthCheckRequest{})
  if err!=nil||response.Status!=healthpb.HealthCheckResponse_SERVING{return errors.New("RPC dependency unavailable")};return nil
 }}
 handler,err:=NewHandler(connection,s.settings.HTTP,ready,s.logger,s.modules[[if .Observability]],[[if .Metrics]]s.metrics[[end]][[if and .Metrics .Tracing]],[[end]][[if .Tracing]]s.tracing[[end]][[end]])
 if err!=nil{s.rpc.Stop();return err}
 httpServer,err:=server.New(handler,s.settings.HTTP,ready,s.logger)
 if err!=nil{s.rpc.Stop();return err}
 rpcContext,stopRPC:=context.WithCancel(context.WithoutCancel(ctx));defer stopRPC()
 rpcDone:=make(chan error,1);go func(){rpcDone<-s.rpc.Serve(rpcContext,grpcListener)}()
 startup,cancel:=context.WithTimeout(ctx,3*time.Second)
 err=waitReady(startup,ready[[if .Metrics]],s.metrics[[end]]);cancel()
 if err!=nil{ready.Stop();s.rpc.Quiesce();stopRPC();return errors.Join(errors.New("gateway RPC startup check failed"),<-rpcDone)}
 httpContext,stopHTTP:=context.WithCancel(context.WithoutCancel(ctx));defer stopHTTP()
 httpDone:=make(chan error,1);go func(){httpDone<-httpServer.Serve(httpContext,httpListener)}()
 var result error;httpReturned,rpcReturned:=false,false
 select{case <-ctx.Done():case result=<-httpDone:httpReturned=true;case result=<-rpcDone:rpcReturned=true}
 ready.Stop();s.rpc.Quiesce();stopHTTP()
 if !httpReturned{result=errors.Join(result,<-httpDone)}
 _ = connection.Close()
 stopRPC();if !rpcReturned{result=errors.Join(result,<-rpcDone)}
 return result
}

func waitReady(ctx context.Context,ready *server.Readiness[[if .Metrics]],metrics *observability.Metrics[[end]])error{
 ticker:=time.NewTicker(20*time.Millisecond);defer ticker.Stop()
 for{budget,cancel:=context.WithTimeout(ctx,200*time.Millisecond);err:=ready.Check(budget);[[if .Metrics]]metrics.RecordDependency(budget,"rpc",err==nil);[[end]]cancel();if err==nil{return nil};select{case <-ctx.Done():return ctx.Err();case <-ticker.C:}}
}

func(s *Server)connect(address string)(*grpc.ClientConn,error){
 host,port,err:=net.SplitHostPort(address);if err!=nil{return nil,errors.New("invalid bound RPC address")}
 if ip:=net.ParseIP(host);ip!=nil&&ip.IsUnspecified(){
  // Go may bind 0.0.0.0 using an IPv6 dual-stack socket. Preserve the
  // configured address family so the loopback matches the certificate SAN.
  configured,_,_:=net.SplitHostPort(s.settings.GRPC.Address)
  configuredIP:=net.ParseIP(configured)
  if ip.To4()!=nil||(configuredIP!=nil&&configuredIP.To4()!=nil){host="127.0.0.1"}else{host="::1"}
 }
 transport:=insecure.NewCredentials()
 if s.settings.GRPC.TLSCert!=""{
  roots,err:=x509.SystemCertPool();if err!=nil{roots=x509.NewCertPool()}
  if s.settings.Gateway.CAFile!=""{pem,err:=os.ReadFile(s.settings.Gateway.CAFile);if err!=nil||!roots.AppendCertsFromPEM(pem){return nil,errors.New("invalid gateway CA file")}}
  transport=credentials.NewTLS(&tls.Config{MinVersion:tls.VersionTLS12,RootCAs:roots,ServerName:s.settings.Gateway.ServerName})
 }
 connection,err:=grpc.NewClient("passthrough:///"+net.JoinHostPort(host,port),grpc.WithTransportCredentials(transport),grpc.WithDefaultCallOptions(grpc.MaxCallRecvMsgSize(s.settings.GRPC.MaxSendBytes),grpc.MaxCallSendMsgSize(s.settings.GRPC.MaxRecvBytes)))
 if err!=nil{return nil,errors.New("cannot create gateway RPC connection")};return connection,nil
}
