"""Explicitly regenerate owned protocol files with project-local fixed tools."""
from pathlib import Path
import os
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
protoc = root / '.tools/protoc/bin/protoc'
tools = root / '.tools/bin'
if not protoc.is_file():
    raise SystemExit('Install protoc 36.2 inside .tools/protoc and run make proto-tools first')
if subprocess.check_output([str(protoc), '--version'], text=True).strip() != 'libprotoc 36.2':
    raise SystemExit('protoc version mismatch')
for name, module, version in [('protoc-gen-go', 'google.golang.org/protobuf', 'v1.36.12'), ('protoc-gen-go-grpc', 'google.golang.org/grpc/cmd/protoc-gen-go-grpc', 'v1.6.2')]:
    metadata = subprocess.check_output(['go', 'version', '-m', str(tools / name)], text=True)
    if not any(line.split()[:3] == ['mod', module, version] for line in metadata.splitlines()):
        raise SystemExit('Protocol plugin version mismatch')
env = os.environ.copy()
env['PATH'] = str(tools) + os.pathsep + env.get('PATH', '')
source = root / 'api/proto'
base = root / '.tmp/proto'
base.mkdir(parents=True, exist_ok=True)
proto_files = sorted(source.glob('*/v1/*.proto'))
if not proto_files:
    raise SystemExit('No module Proto files found under api/proto/*/v1')

with tempfile.TemporaryDirectory(dir=base) as temporary:
    for proto in proto_files:
        module = proto.parent.parent.name
        output = Path(temporary) / module
        output.mkdir()
        relative = proto.name
        go_package = f'[[.Module]]/pkg/api/{module}/v1;{module}v1'
        command = [
            str(protoc),
            '-I' + str(proto.parent),
            '-I' + str(source),
            '-I' + str(root / '.tools/protoc/include'),
            '--go_out=paths=source_relative:' + str(output),
            '--go-grpc_out=paths=source_relative:' + str(output),
            '--go_opt=M' + relative + '=' + go_package,
            '--go-grpc_opt=M' + relative + '=' + go_package,
            proto.name,
        ]
        subprocess.run(command, cwd=proto.parent, env=env, check=True)
        destination = root / 'pkg/api' / module / 'v1'
        destination.mkdir(parents=True, exist_ok=True)
        for name in (proto.stem + '.pb.go', proto.stem + '_grpc.pb.go'):
            (destination / name).write_bytes((output / name).read_bytes())
print(f'Regenerated protocol files for {len(proto_files)} module(s)')
