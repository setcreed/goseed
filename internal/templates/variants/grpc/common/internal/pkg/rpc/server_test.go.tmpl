[[if eq .Authz "casbin"]]type allowTest struct{}
func(allowTest)Authorize(ctx context.Context,subject,resource,operation string)error{return ctx.Err()}[[end]]
type testPort interface{call(context.Context,*healthpb.HealthCheckRequest)(*healthpb.HealthCheckResponse,error)}
type testHandler struct{callFn func(context.Context,*healthpb.HealthCheckRequest)(*healthpb.HealthCheckResponse,error)}
func(h *testHandler)call(ctx context.Context,request *healthpb.HealthCheckRequest)(*healthpb.HealthCheckResponse,error){return h.callFn(ctx,request)}
func testRPC(t *testing.T,budget,shutdown time.Duration,reflection bool,ready *Readiness,handler *testHandler)(*grpc.ClientConn,*Server,context.CancelFunc,<-chan error,string){
 t.Helper();jwt,err:=auth.New(config.JWT{Secret:base64.StdEncoding.EncodeToString(make([]byte,32)),Issuer:"test",Audience:"test-api",TTL:time.Minute});if err!=nil{t.Fatal(err)};token,err:=jwt.Issue("alice",time.Minute);if err!=nil{t.Fatal(err)}
 register := func(registrar grpc.ServiceRegistrar) {
  registrar.RegisterService(&grpc.ServiceDesc{
   ServiceName: "test.Test", HandlerType: (*testPort)(nil),
   Methods: []grpc.MethodDesc{{MethodName: "Call", Handler: func(service any, ctx context.Context, decode func(any) error, interceptor grpc.UnaryServerInterceptor) (any, error) {
    request := new(healthpb.HealthCheckRequest)
    if err := decode(request); err != nil { return nil, err }
    return interceptor(ctx, request, &grpc.UnaryServerInfo{Server: service, FullMethod: "/test.Test/Call"}, func(ctx context.Context, request any) (any, error) {
     return service.(testPort).call(ctx, request.(*healthpb.HealthCheckRequest))
    })
   }}},
  }, handler)
 }
 server,err:=New(config.GRPC{RequestTimeout:budget,ShutdownTimeout:shutdown,MaxRecvBytes:1024,MaxSendBytes:1024,MaxHeaderBytes:4096,MaxConcurrentStreams:16,Reflection:reflection},ready,zap.NewNop(),jwt,map[string]string{"/test.Test/Call":"read"},register[[if eq .Authz "casbin"]],allowTest{}[[end]]);if err!=nil{t.Fatal(err)}
 listener,err:=net.Listen("tcp","127.0.0.1:0");if err!=nil{t.Fatal(err)};ctx,cancel:=context.WithCancel(context.Background());finished:=make(chan error,1);go func(){finished<-server.Serve(ctx,listener)}()
 client,err:=grpc.NewClient(listener.Addr().String(),grpc.WithTransportCredentials(insecure.NewCredentials()),grpc.WithDisableRetry());if err!=nil{t.Fatal(err)}
 t.Cleanup(func(){cancel();_ = client.Close()})
 return client,server,cancel,finished,token
}
func TestSecurityBudgetRecoveryAndHealthWatch(t *testing.T){
 var badDependency atomic.Bool
 ready:=&Readiness{CheckDependency:func(ctx context.Context)error{if badDependency.Load(){return errors.New("private dependency cause")};return ctx.Err()}}
 handler:=&testHandler{callFn:func(ctx context.Context,request *healthpb.HealthCheckRequest)(*healthpb.HealthCheckResponse,error){switch request.Service{case "panic":panic("private panic");case "raw":return nil,errors.New("private storage cause");case "slow":<-ctx.Done();return nil,Status(ctx,ctx.Err());default:if contextx.Subject(ctx)!="alice"||contextx.RequestID(ctx)!="request.1"{return nil,status.Error(codes.Internal,"context lost")};return &healthpb.HealthCheckResponse{Status:healthpb.HealthCheckResponse_SERVING},nil}}}
 client,_,cancel,finished,token:=testRPC(t,40*time.Millisecond,time.Second,false,ready,handler)
 call:=func(ctx context.Context,text string)error{return client.Invoke(ctx,"/test.Test/Call",&healthpb.HealthCheckRequest{Service:text},new(healthpb.HealthCheckResponse))}
 if status.Code(call(context.Background(),""))!=codes.Unauthenticated{t.Fatal("missing JWT accepted")}
 ctx:=metadata.NewOutgoingContext(context.Background(),metadata.Pairs("authorization","Bearer "+token,"x-request-id","request.1"))
 var headers metadata.MD;var response healthpb.HealthCheckResponse
 if err:=client.Invoke(ctx,"/test.Test/Call",&healthpb.HealthCheckRequest{},&response,grpc.Header(&headers));err!=nil||len(headers.Get("x-request-id"))!=1||headers.Get("x-request-id")[0]!="request.1"{t.Fatal("context or response ID",err)}
 duplicate:=metadata.AppendToOutgoingContext(ctx,"authorization","Bearer "+token);if status.Code(call(duplicate,""))!=codes.Unauthenticated{t.Fatal("duplicate authorization accepted")}
 invalid:=metadata.NewOutgoingContext(context.Background(),metadata.Pairs("authorization","Bearer "+token,"x-request-id","private bad ID"));if status.Code(call(invalid,""))!=codes.InvalidArgument{t.Fatal("invalid ID accepted")}
 if err:=call(ctx,"panic");status.Code(err)!=codes.Internal||strings.Contains(err.Error(),"private"){t.Fatal("panic disclosed")}
 if err:=call(ctx,"raw");status.Code(err)!=codes.Internal||strings.Contains(err.Error(),"private"){t.Fatal("raw error disclosed")}
 if status.Code(call(ctx,"slow"))!=codes.DeadlineExceeded{t.Fatal("server budget ignored")}
 early,end:=context.WithTimeout(ctx,5*time.Millisecond);defer end();if status.Code(call(early,"slow"))!=codes.DeadlineExceeded{t.Fatal("caller deadline lost")}
 canceled,endCancel:=context.WithCancel(ctx);endCancel();if status.Code(call(canceled,""))!=codes.Canceled{t.Fatal("caller cancel lost")}
 if status.Code(call(ctx,strings.Repeat("x",2048)))!=codes.ResourceExhausted{t.Fatal("message limit ignored")}
 health:=healthpb.NewHealthClient(client);watchCtx,stopWatch:=context.WithTimeout(context.Background(),3*time.Second);defer stopWatch();watch,err:=health.Watch(watchCtx,&healthpb.HealthCheckRequest{});if err!=nil{t.Fatal(err)}
 next:=func(want healthpb.HealthCheckResponse_ServingStatus){t.Helper();for{value,err:=watch.Recv();if err!=nil{t.Fatal(err)};if value.Status==want{return}}}
 next(healthpb.HealthCheckResponse_SERVING);badDependency.Store(true);value,err:=health.Check(context.Background(),&healthpb.HealthCheckRequest{});if err!=nil||value.Status!=healthpb.HealthCheckResponse_NOT_SERVING{t.Fatal("stale readiness")};next(healthpb.HealthCheckResponse_NOT_SERVING)
 live,err:=health.Check(context.Background(),&healthpb.HealthCheckRequest{Service:"liveness"});if err!=nil||live.Status!=healthpb.HealthCheckResponse_SERVING{t.Fatal("liveness depended on DB")};badDependency.Store(false);next(healthpb.HealthCheckResponse_SERVING)
 cancel();select{case err:=<-finished:if err!=nil{t.Fatal("Watch stranded graceful shutdown",err)};case <-time.After(2*time.Second):t.Fatal("shutdown blocked")}
}
func TestShutdownForcesCancellation(t *testing.T){
 entered:=make(chan struct{});aborted:=make(chan struct{})
 handler:=&testHandler{callFn:func(ctx context.Context,_ *healthpb.HealthCheckRequest)(*healthpb.HealthCheckResponse,error){close(entered);<-ctx.Done();close(aborted);return nil,Status(ctx,ctx.Err())}}
 client,_,cancel,finished,token:=testRPC(t,time.Second,20*time.Millisecond,false,&Readiness{},handler)
 ctx:=metadata.NewOutgoingContext(context.Background(),metadata.Pairs("authorization","Bearer "+token));callDone:=make(chan struct{});go func(){defer close(callDone);_ = client.Invoke(ctx,"/test.Test/Call",&healthpb.HealthCheckRequest{},new(healthpb.HealthCheckResponse))}()
 select{case <-entered:case <-time.After(time.Second):t.Fatal("request not entered")};cancel();select{case err:=<-finished:if err==nil{t.Fatal("forced shutdown reported graceful")};case <-time.After(time.Second):t.Fatal("shutdown hung")}
 select{case <-aborted:case <-time.After(time.Second):t.Fatal("Stop failed to cancel handler")};<-callDone
}
