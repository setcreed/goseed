func TestReflectionRequiresAuthentication(t *testing.T){
 handler:=&testHandler{callFn:func(ctx context.Context,_ *healthpb.HealthCheckRequest)(*healthpb.HealthCheckResponse,error){return &healthpb.HealthCheckResponse{},nil}}
 client,_,cancel,finished,token:=testRPC(t,time.Second,time.Second,true,&Readiness{},handler)
 contextBudget,end:=context.WithTimeout(context.Background(),time.Second);defer end()
 reflection:=reflectionpb.NewServerReflectionClient(client)
 denied,err:=reflection.ServerReflectionInfo(contextBudget);if err!=nil{t.Fatal(err)};if err:=denied.Send(&reflectionpb.ServerReflectionRequest{MessageRequest:&reflectionpb.ServerReflectionRequest_ListServices{ListServices:""}});err!=nil&&!errors.Is(err,io.EOF){t.Fatal(err)};if _,err:=denied.Recv();status.Code(err)!=codes.Unauthenticated{t.Fatal("anonymous reflection allowed",err)};_ = denied.CloseSend()
 authorized:=metadata.NewOutgoingContext(contextBudget,metadata.Pairs("authorization","Bearer "+token));stream,err:=reflection.ServerReflectionInfo(authorized);if err!=nil{t.Fatal(err)};if err:=stream.Send(&reflectionpb.ServerReflectionRequest{MessageRequest:&reflectionpb.ServerReflectionRequest_ListServices{ListServices:""}});err!=nil{t.Fatal(err)};value,err:=stream.Recv();if err!=nil||len(value.GetListServicesResponse().Service)==0{t.Fatal("authenticated reflection failed",err)};_ = stream.CloseSend();_,_ = stream.Recv()
 cancel();if err:=<-finished;err!=nil{t.Fatal(err)}
}
