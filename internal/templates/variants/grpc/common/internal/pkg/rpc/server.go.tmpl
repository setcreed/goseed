type grpcMetadataCarrier metadata.MD
func(c grpcMetadataCarrier)Get(key string)string{values:=metadata.MD(c).Get(key);if len(values)==0{return ""};return values[0]}
func(c grpcMetadataCarrier)Set(key,value string){metadata.MD(c).Set(key,value)}
func(c grpcMetadataCarrier)Keys()[]string{keys:=make([]string,0,len(c));for key:=range c{keys=append(keys,key)};return keys}
[[end]]
[[if .Observability]]
type contextServerStream struct{grpc.ServerStream;ctx context.Context}
func(s *contextServerStream)Context()context.Context{return s.ctx}
[[end]]
type healthService struct{*health.Server;ready *Readiness}
func(h *healthService)Watch(request *healthpb.HealthCheckRequest,stream grpc.ServerStreamingServer[healthpb.HealthCheckResponse])error{if len(request.ProtoReflect().GetUnknown())!=0{return status.Error(codes.InvalidArgument,"unknown request field")};if request.Service!=""&&request.Service!=ExampleService&&request.Service!="liveness"{return status.Error(codes.NotFound,"unknown service")};return h.Server.Watch(request,stream)}
func(h *healthService)Check(ctx context.Context,request *healthpb.HealthCheckRequest)(*healthpb.HealthCheckResponse,error){
 if len(request.ProtoReflect().GetUnknown())!=0{return nil,status.Error(codes.InvalidArgument,"unknown request field")}
 if request.Service!=""&&request.Service!=ExampleService&&request.Service!="liveness"{return nil,status.Error(codes.NotFound,"unknown service")}
 state:=healthpb.HealthCheckResponse_SERVING
 if request.Service=="liveness"{if h.ready.stopping.Load(){state=healthpb.HealthCheckResponse_NOT_SERVING}}else{budget,cancel:=context.WithTimeout(ctx,200*time.Millisecond);defer cancel();if h.ready.Check(budget)!=nil{state=healthpb.HealthCheckResponse_NOT_SERVING}}
 return &healthpb.HealthCheckResponse{Status:state},nil
}
func(s *Server)Run(ctx context.Context)error{listener,err:=net.Listen("tcp",s.settings.Address);if err!=nil{s.watchStop();return errors.New("cannot listen on configured gRPC address")};return s.Serve(ctx,listener)}
// Stop releases a server that could not enter Serve during multi-port startup.
func(s *Server)Stop(){s.ready.Stop();s.health.Shutdown();s.watchStop();s.grpc.Stop()}
// Quiesce stops operational readiness and watches while unary calls drain.
func(s *Server)Quiesce(){s.ready.Stop();s.health.Shutdown();s.watchStop()}
func(s *Server)Serve(ctx context.Context,listener net.Listener)error{
 defer func(){_ = listener.Close()}();if !s.running.CompareAndSwap(false,true){return errors.New("gRPC server already served")}
 monitor,end:=context.WithCancel(ctx);defer end();updates:=make(chan struct{});go func(){defer close(updates);ticker:=time.NewTicker(500*time.Millisecond);defer ticker.Stop();for{state:=healthpb.HealthCheckResponse_SERVING;budget,cancel:=context.WithTimeout(monitor,200*time.Millisecond);if s.ready.Check(budget)!=nil{state=healthpb.HealthCheckResponse_NOT_SERVING};cancel();s.health.SetServingStatus("",state);s.health.SetServingStatus(ExampleService,state);s.health.SetServingStatus("liveness",healthpb.HealthCheckResponse_SERVING);select{case <-monitor.Done():return;case <-ticker.C:}}}()
 finished:=make(chan error,1);go func(){finished<-s.grpc.Serve(listener)}();s.logger.Info("gRPC server started",zap.String("address",listener.Addr().String()))
 var serveError error;returned:=false
 select{case serveError=<-finished:returned=true;case <-ctx.Done():}
 s.ready.Stop();end();<-updates;s.health.Shutdown();s.watchStop()
 drained:=make(chan struct{});go func(){s.grpc.GracefulStop();close(drained)}();timer:=time.NewTimer(s.settings.ShutdownTimeout);defer timer.Stop();forced:=false
 select{case <-drained:case <-timer.C:forced=true;s.grpc.Stop();<-drained}
 if !returned{serveError=<-finished};if forced{return errors.New("gRPC shutdown exceeded its deadline")};if serveError!=nil&&!errors.Is(serveError,grpc.ErrServerStopped){return errors.New("gRPC server stopped unexpectedly")};return nil
}
