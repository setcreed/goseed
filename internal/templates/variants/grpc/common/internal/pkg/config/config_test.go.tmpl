package config
import (
 "encoding/base64"
 "os"
 "path/filepath"
 "testing"
)
func TestGRPCConfiguration(t *testing.T){
 t.Setenv("APP_ENV","development");t.Setenv("APP_JWT_SECRET",base64.StdEncoding.EncodeToString(make([]byte,32)))
 [[if or (eq .Database "mysql") (eq .Database "postgres")]]t.Setenv("APP_DATABASE_PASSWORD","placeholder")[[end]]
 [[if .Redis]]t.Setenv("APP_REDIS_PASSWORD","placeholder")[[end]]
 path:=filepath.Join(t.TempDir(),"app.yaml");t.Setenv("APP_GRPC_ADDRESS","127.0.0.1:9001")
 if err:=os.WriteFile(path,[]byte("grpc:\n  address: 127.0.0.1:9000\n"),0600);err!=nil{t.Fatal(err)};settings,err:=Load(path,true,Overrides{[[if eq .Transport "dual"]]GRPCAddress[[else]]Address[[end]]:"127.0.0.1:9002"});if err!=nil||settings.GRPC.Address!="127.0.0.1:9002"{t.Fatal("precedence",err)}
 settings,err=Load(path+"missing",false,Overrides{});if err!=nil||settings.GRPC.Address!="127.0.0.1:9001"{t.Fatal("environment-only",err)};if _,err:=Load(path+"missing",true,Overrides{});err==nil{t.Fatal("explicit missing accepted")}
 for _,text:=range []string{[[if ne .Transport "dual"]]"http:\n  address: 127.0.0.1:9000\n",[[end]]"grpc:\n  request_timeout: 5\n","grpc:\n  request_timeout: 0s\n","grpc:\n  reflection: 1\n","grpc:\n  max_recv_bytes: 0\n","grpc:\n  max_header_bytes: 12\n","grpc:\n  max_concurrent_streams: 1025\n","grpc:\n  tls_cert: cert\n"}{if err:=os.WriteFile(path,[]byte(text),0600);err!=nil{t.Fatal(err)};if _,err:=Load(path,true,Overrides{});err==nil{t.Fatal("invalid configuration accepted")}}
 t.Setenv("APP_ENV","production");if err:=os.WriteFile(path,[]byte("{}\n"),0600);err!=nil{t.Fatal(err)};if _,err:=Load(path,true,Overrides{});err==nil{t.Fatal("production plaintext accepted")}
 if err:=os.WriteFile(path,[]byte("grpc:\n  tls_cert: cert\n  tls_key: key\n  reflection: true\n"),0600);err!=nil{t.Fatal(err)};if _,err:=Load(path,true,Overrides{});err==nil{t.Fatal("production reflection accepted")}
}
