syntax = "proto3";
package example.v1;
option go_package = "example/v1;examplev1";
import "google/protobuf/empty.proto";
import "google/protobuf/timestamp.proto";
service ExampleService {
 rpc Create(CreateRequest) returns (Example);
 rpc Get(GetRequest) returns (Example);
 rpc List(ListRequest) returns (ListResponse);
 rpc Update(UpdateRequest) returns (Example);
 rpc Delete(GetRequest) returns (google.protobuf.Empty);
}
message Example { uint64 id=1; string owner=2; string name=3; string description=4; bool enabled=5; google.protobuf.Timestamp created_at=6; google.protobuf.Timestamp updated_at=7; }
message CreateRequest { string name=1; string description=2; optional bool enabled=3; }
message GetRequest { uint64 id=1; }
message ListRequest { optional int32 page=1; optional int32 page_size=2; }
message ListResponse { repeated Example items=1; int64 total=2; int32 page=3; int32 page_size=4; }
message UpdateRequest { uint64 id=1; optional string name=2; optional string description=3; optional bool enabled=4; }
