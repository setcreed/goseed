package example

import (
 "context"
 "math"
 api "[[.Module]]/pkg/api/example/v1"
 biz "[[.Module]]/internal/apiserver/biz/example"
 "[[.Module]]/internal/apiserver/model"
 "[[.Module]]/internal/pkg/errno"
 "[[.Module]]/internal/pkg/rpc"
 "google.golang.org/grpc"
 "google.golang.org/protobuf/proto"
 "google.golang.org/protobuf/types/known/emptypb"
 "google.golang.org/protobuf/types/known/timestamppb"
)
var Permissions=map[string]string{api.ExampleService_Create_FullMethodName:"create",api.ExampleService_Get_FullMethodName:"read",api.ExampleService_List_FullMethodName:"read",api.ExampleService_Update_FullMethodName:"update",api.ExampleService_Delete_FullMethodName:"delete"}
type Handler struct{api.UnimplementedExampleServiceServer;biz *biz.Biz}
func New(business *biz.Biz)*Handler{return &Handler{biz:business}}
func(h *Handler)Register(registrar grpc.ServiceRegistrar){api.RegisterExampleServiceServer(registrar,h)}
func valid(request proto.Message)error{if !request.ProtoReflect().IsValid()||len(request.ProtoReflect().GetUnknown())!=0{return errno.Invalid("unknown or missing request fields")};return nil}
func identifier(id uint64)error{if id<1||id>math.MaxInt64{return errno.Invalid("id must be positive and fit int64")};return nil}
func item(value *model.Example)*api.Example{return &api.Example{Id:value.ID,Owner:value.Owner,Name:value.Name,Description:value.Description,Enabled:value.Enabled,CreatedAt:timestamppb.New(value.CreatedAt),UpdatedAt:timestamppb.New(value.UpdatedAt)}}
func(h *Handler)Create(ctx context.Context,request *api.CreateRequest)(*api.Example,error){if err:=valid(request);err!=nil{return nil,rpc.Status(ctx,err)};value,err:=h.biz.Create(ctx,biz.CreateInput{Name:request.Name,Description:request.Description,Enabled:request.Enabled});if err!=nil{return nil,rpc.Status(ctx,err)};return item(value),nil}
func(h *Handler)Get(ctx context.Context,request *api.GetRequest)(*api.Example,error){if err:=valid(request);err!=nil{return nil,rpc.Status(ctx,err)};if err:=identifier(request.Id);err!=nil{return nil,rpc.Status(ctx,err)};value,err:=h.biz.Get(ctx,request.Id);if err!=nil{return nil,rpc.Status(ctx,err)};return item(value),nil}
func(h *Handler)List(ctx context.Context,request *api.ListRequest)(*api.ListResponse,error){if err:=valid(request);err!=nil{return nil,rpc.Status(ctx,err)};page,size:=int32(1),int32(20);if request.Page!=nil{page=*request.Page};if request.PageSize!=nil{size=*request.PageSize};value,err:=h.biz.List(ctx,int(page),int(size));if err!=nil{return nil,rpc.Status(ctx,err)};items:=make([]*api.Example,0,len(value.Items));for i:=range value.Items{items=append(items,item(&value.Items[i]))};return &api.ListResponse{Items:items,Total:value.Total,Page:int32(value.Page),PageSize:int32(value.PageSize)},nil}
func(h *Handler)Update(ctx context.Context,request *api.UpdateRequest)(*api.Example,error){if err:=valid(request);err!=nil{return nil,rpc.Status(ctx,err)};if err:=identifier(request.Id);err!=nil{return nil,rpc.Status(ctx,err)};value,err:=h.biz.Update(ctx,request.Id,model.ExampleChanges{Name:request.Name,Description:request.Description,Enabled:request.Enabled});if err!=nil{return nil,rpc.Status(ctx,err)};return item(value),nil}
func(h *Handler)Delete(ctx context.Context,request *api.GetRequest)(*emptypb.Empty,error){if err:=valid(request);err!=nil{return nil,rpc.Status(ctx,err)};if err:=identifier(request.Id);err!=nil{return nil,rpc.Status(ctx,err)};if err:=h.biz.Delete(ctx,request.Id);err!=nil{return nil,rpc.Status(ctx,err)};return &emptypb.Empty{},nil}
