server {
    listen 80;
    server_name grpc.example.invalid;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name grpc.example.invalid;

    ssl_certificate     /etc/[[.Name]]/tls/public-fullchain.pem;
    ssl_certificate_key /etc/[[.Name]]/tls/public-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        grpc_pass grpcs://127.0.0.1:9090;
        grpc_ssl_trusted_certificate /etc/[[.Name]]/tls/grpc-ca.pem;
        grpc_ssl_verify on;
        grpc_ssl_name grpc.internal;
        grpc_ssl_server_name on;
        grpc_set_header Host $host;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_set_header X-Forwarded-For $remote_addr;
        grpc_set_header X-Forwarded-Proto $scheme;
    }
}
