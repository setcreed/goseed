#!/bin/sh
set -eu
umask 077

credentials=/etc/[[.Name]]/pgpass
database=[[.Name]]
backup_dir=/var/backups/[[.Name]]
mkdir -p "$backup_dir"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
temporary=$(mktemp "$backup_dir/[[.Name]]-$stamp.XXXXXX")
backup=${temporary}.dump
cleanup() { rm -f "$temporary"; }
trap cleanup EXIT HUP INT TERM
PGPASSFILE="$credentials" PGSSLMODE=verify-full pg_dump --format=custom --file="$temporary" "$database"
test -s "$temporary"
mv "$temporary" "$backup"
trap - EXIT HUP INT TERM
printf '%s\n' "$backup"
