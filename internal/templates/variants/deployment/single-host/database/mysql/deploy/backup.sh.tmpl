#!/bin/sh
set -eu
umask 077

credentials=/etc/[[.Name]]/backup-mysql.cnf
database=[[.Name]]
backup_dir=/var/backups/[[.Name]]
mkdir -p "$backup_dir"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
temporary=$(mktemp "$backup_dir/[[.Name]]-$stamp.XXXXXX")
backup=${temporary}.sql
cleanup() { rm -f "$temporary"; }
trap cleanup EXIT HUP INT TERM
mysqldump --defaults-extra-file="$credentials" --single-transaction --skip-lock-tables --no-tablespaces --triggers --routines --events "$database" > "$temporary"
test -s "$temporary"
mv "$temporary" "$backup"
trap - EXIT HUP INT TERM
printf '%s\n' "$backup"
