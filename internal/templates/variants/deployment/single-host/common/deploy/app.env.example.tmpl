APP_ENV=production
APP_HTTP_ADDRESS=127.0.0.1:8080
APP_JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
[[if eq .Transport "grpc"]]APP_GRPC_ADDRESS=127.0.0.1:9090
APP_GRPC_TLS_CERT=/etc/[[.Name]]/tls/grpc.crt
APP_GRPC_TLS_KEY=/etc/[[.Name]]/tls/grpc.key[[else if or (eq .Transport "dual") (eq .Transport "gateway")]]APP_GRPC_ADDRESS=127.0.0.1:9090
APP_GRPC_TLS_CERT=/etc/[[.Name]]/tls/grpc.crt
APP_GRPC_TLS_KEY=/etc/[[.Name]]/tls/grpc.key[[if eq .Transport "gateway"]]
APP_GATEWAY_CA_FILE=/etc/[[.Name]]/tls/grpc-ca.pem
APP_GATEWAY_SERVER_NAME=grpc.internal[[end]][[end]]
[[if eq .Database "sqlite"]]APP_DATABASE_PATH=/var/lib/[[.Name]]/app.db[[else if eq .Database "mysql"]]APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=3306
APP_DATABASE_USER=[[.Name]]
APP_DATABASE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
APP_DATABASE_NAME=[[.Name]][[else if eq .Database "postgres"]]APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=5432
APP_DATABASE_USER=[[.Name]]
APP_DATABASE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
APP_DATABASE_NAME=[[.Name]]
APP_DATABASE_TLS=true
APP_DATABASE_CA_FILE=/etc/[[.Name]]/tls/database-ca.pem[[end]]
[[if .Redis]]APP_REDIS_ADDRESS=127.0.0.1:6379
APP_REDIS_USERNAME=REPLACE_WITH_REDIS_USERNAME
APP_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
APP_REDIS_TLS=true
APP_REDIS_CA_FILE=/etc/[[.Name]]/tls/redis-ca.pem[[end]]
