    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "值为 Bearer <token>；JWT 固定 HS256。"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "parameters": {
    "RequestID": {
      "name": "X-Request-ID",
      "in": "header",
      "required": false,
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "无效值重新生成，响应头返回 ID。"
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "进程存活",
        "security": [],
        "responses": {
          "200": {
            "description": "进程可响应",
            "schema": {
              "$ref": "#/definitions/Health"
            },
            "headers": {
              "X-Request-ID": {
                "type": "string"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/parameters/RequestID"
          }
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "summary": "服务关闭状态就绪检查",
        "security": [],
        "responses": {
          "200": {
            "description": "就绪",
            "schema": {
              "$ref": "#/definitions/Health"
            },
            "headers": {
              "X-Request-ID": {
                "type": "string"
              }
            }
          },
          "503": {
            "description": "不可用",
            "schema": {
              "$ref": "#/definitions/Health"
            },
            "headers": {
              "X-Request-ID": {
                "type": "string"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/parameters/RequestID"
          }
        ]
      }
    },
    "/v1/examples": {
      "get": {
        "operationId": "greet",
        "summary": "需要 JWT 认证的无持久化问候",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/parameters/RequestID"
          },
          {
            "name": "name",
            "in": "query",
            "type": "string",
            "required": false,
            "default": "world",
            "minLength": 1,
            "maxLength": 80,
            "description": "Valid UTF-8, no controls or surrounding whitespace; no other or duplicate parameters."
          }
        ],
        "responses": {
          "200": {
            "description": "Greeting",
            "schema": {
              "$ref": "#/definitions/Greeting"
            }
          },
          "400": {
            "description": "Invalid input",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Authentication required",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "504": {
            "description": "Request timeout",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "503": {
            "description": "Required dependency unavailable",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      }
    },
    "Health": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "unavailable"
          ]
        }
      }
    },
    "Greeting": {
      "type": "object",
      "required": [
        "message",
        "subject"
      ],
      "properties": {
        "message": {
          "type": "string",
          "example": "hello, world"
        },
        "subject": {
          "type": "string",
          "example": "alice"
        }
      }
    }
  }
}
