{
  "swagger": "2.0",
  "info": {
    "title": "[[.Name]] HTTP API",
    "version": "v1",
    "description": "需要 JWT 认证的无持久化问候示例。拒绝未知、重复或无效查询参数。"
  },
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
