// Package testutil creates only disposable test databases in explicitly opted-in environments.
package testutil

import (
 "context"
 "crypto/rand"
 "encoding/hex"
 "encoding/base64"
 "os"
 "path/filepath"
 "testing"
 "time"

 "[[.Module]]/internal/pkg/config"
 "[[.Module]]/internal/pkg/database"
 "go.uber.org/zap"
)

// Configuration creates a uniquely named database; it never resets an existing one.
func Configuration(t *testing.T)config.Config{
 t.Helper()
 if os.Getenv("GOSEED_TEST_EXTERNAL")!="1" {t.Skip("real [[.Database]] tests require GOSEED_TEST_EXTERNAL=1 and dedicated test credentials")}
 t.Setenv("APP_JWT_SECRET",base64.StdEncoding.EncodeToString(make([]byte,32)))
 t.Setenv("APP_ENV","development");t.Setenv("APP_DATABASE_TLS","false")
 for _,field:=range []string{"HOST","PORT","USER","PASSWORD"}{value:=os.Getenv("GOSEED_TEST_DATABASE_"+field);if value==""{t.Fatal("missing dedicated external test configuration")};t.Setenv("APP_DATABASE_"+field,value)}
 settings,err:=config.Load(filepath.Join(t.TempDir(),"absent.yaml"),false,config.Overrides{});if err!=nil{t.Fatal(err)}
 settings.Database.Name="[[if eq .Database "mysql"]]mysql[[else]]postgres[[end]]"
 ctx,cancel:=context.WithTimeout(context.Background(),10*time.Second);defer cancel()
 admin,err:=database.Open(ctx,settings.Database,zap.NewNop());if err!=nil{t.Fatal(err)}
 var random [12]byte;if _,err:=rand.Read(random[:]);err!=nil{_ = admin.Close();t.Fatal(err)}
 name:="goseed_test_"+hex.EncodeToString(random[:])
 // The identifier consists solely of the fixed prefix and hex, never user input.
 if err:=admin.DB.WithContext(ctx).Exec("CREATE DATABASE "+name[[if eq .Database "mysql"]]+" CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin"[[end]]).Error;err!=nil{_ = admin.Close();t.Fatal("cannot create isolated test database")}
 t.Cleanup(func(){ctx,cancel:=context.WithTimeout(context.Background(),10*time.Second);defer cancel();defer func(){_ = admin.Close()}();if err:=admin.DB.WithContext(ctx).Exec("DROP DATABASE "+name).Error;err!=nil{t.Error("cannot remove owned test database")}})
 settings.Database.Name=name
 return settings
}

func Database(t *testing.T)*database.Database{
 t.Helper();settings:=Configuration(t);ctx,cancel:=context.WithTimeout(context.Background(),10*time.Second);defer cancel()
 db,err:=database.Open(ctx,settings.Database,zap.NewNop());if err!=nil{t.Fatal(err)}
 t.Cleanup(func(){_ = db.Close()})
 if err:=db.Migrate(ctx);err!=nil{t.Fatal(err)}
 return db
}
