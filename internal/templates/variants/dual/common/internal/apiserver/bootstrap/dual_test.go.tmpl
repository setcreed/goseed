package bootstrap

import (
 "context"
 "encoding/base64"
 "net"
 [[if and (eq .Database "none") (eq .Authz "casbin")]]"os"[[end]]
 [[if or (eq .Database "sqlite") (eq .Database "none")]]"path/filepath"
 "[[.Module]]/internal/pkg/config"[[else]]"[[.Module]]/internal/testutil"[[end]]
 [[if ne .Database "none"]]"[[.Module]]/internal/pkg/database"
 "go.uber.org/zap"[[end]]
 "testing"
)

func TestDualRPCStartupFailuresCloseSharedPool(t *testing.T){
 t.Setenv("APP_ENV","development");t.Setenv("APP_JWT_SECRET",base64.StdEncoding.EncodeToString(make([]byte,32)))
 [[if .Redis]]t.Setenv("APP_REDIS_PASSWORD","placeholder");t.Setenv("APP_REDIS_TLS","false");t.Setenv("APP_REDIS_ADDRESS","127.0.0.1:1")[[end]]
 [[if or (eq .Database "mysql") (eq .Database "postgres")]]settings:=testutil.Configuration(t)
 [[else]]settings,err:=config.Load(filepath.Join(t.TempDir(),"absent.yaml"),false,config.Overrides{});if err!=nil{t.Fatal(err)}
 [[if eq .Database "sqlite"]]settings.Database.Path=filepath.Join(t.TempDir(),"app.db")[[end]][[end]]
 [[if ne .Database "none"]]db,err:=database.Open(context.Background(),settings.Database,zap.NewNop());if err!=nil{t.Fatal(err)};if err:=db.Migrate(context.Background());err!=nil{t.Fatal(err)};_ = db.Close()[[end]]
 [[if and (eq .Database "none") (eq .Authz "casbin")]]settings.Authz.PolicyFile=filepath.Join(t.TempDir(),"policy.csv");if err:=os.WriteFile(settings.Authz.PolicyFile,nil,0600);err!=nil{t.Fatal(err)}[[end]]
 settings.GRPC.TLSCert="missing-cert";settings.GRPC.TLSKey="missing-key";if _,err:=New(settings,"test");err==nil{t.Fatal("invalid RPC certificate accepted")};settings.GRPC.TLSCert="";settings.GRPC.TLSKey=""
 available,err:=net.Listen("tcp","127.0.0.1:0");if err!=nil{t.Fatal(err)};settings.HTTP.Address=available.Addr().String();_ = available.Close()
 occupied,err:=net.Listen("tcp","127.0.0.1:0");if err!=nil{t.Fatal(err)};defer func(){_ = occupied.Close()}();settings.GRPC.Address=occupied.Addr().String()
 application,err:=New(settings,"test");if err!=nil{t.Fatal(err)}
 if err:=application.Run(context.Background());err==nil{t.Fatal("occupied RPC port accepted")}
 recovered,err:=net.Listen("tcp",settings.HTTP.Address);if err!=nil{t.Fatal("failed RPC startup leaked HTTP listener")};_ = recovered.Close()
 [[if ne .Database "none"]]if err:=application.Database.Pool.Ping();err==nil{t.Fatal("dual startup leaked shared pool")}
 db,err=database.Open(context.Background(),settings.Database,zap.NewNop());if err!=nil{t.Fatal(err)};if err:=db.CheckSchema(context.Background());err!=nil{t.Fatal("failed startup damaged persistence")};_ = db.Close()[[end]]
}
