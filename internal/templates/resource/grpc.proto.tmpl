syntax = "proto3";

package [[.Name]].v1;

option go_package = "[[.Module]]/pkg/api/[[.Name]]/v1;[[.Name]]v1";

import "google/protobuf/empty.proto";
import "google/protobuf/timestamp.proto";

service [[.GoName]]Service {
  rpc Create(Create[[.GoName]]Request) returns ([[.GoName]]Item);
  rpc Get(Get[[.GoName]]Request) returns ([[.GoName]]Item);
  rpc List(List[[.GoName]]Request) returns ([[.GoName]]Page);
  rpc Update(Update[[.GoName]]Request) returns ([[.GoName]]Item);
  rpc Delete(Delete[[.GoName]]Request) returns (google.protobuf.Empty);
}

message [[.GoName]]Item {
  uint64 id = 1;
[[range $i, $field := .Fields]]  [[if eq $field.Type "string"]]string[[else if eq $field.Type "bool"]]bool[[else]]int64[[end]] [[$field.Name]] = [[add $i 2]];
[[end]]  google.protobuf.Timestamp created_at = [[add (len .Fields) 2]];
  google.protobuf.Timestamp updated_at = [[add (len .Fields) 3]];
}

message Create[[.GoName]]Request {
[[range $i, $field := .Fields]]  optional [[if eq $field.Type "string"]]string[[else if eq $field.Type "bool"]]bool[[else]]int64[[end]] [[$field.Name]] = [[add $i 1]];
[[end]]}

message Get[[.GoName]]Request { uint64 id = 1; }

message List[[.GoName]]Request {
  optional int32 page = 1;
  optional int32 page_size = 2;
}

message Update[[.GoName]]Request {
  uint64 id = 1;
[[range $i, $field := .Fields]]  optional [[if eq $field.Type "string"]]string[[else if eq $field.Type "bool"]]bool[[else]]int64[[end]] [[$field.Name]] = [[add $i 2]];
[[end]]}

message Delete[[.GoName]]Request { uint64 id = 1; }

message [[.GoName]]Page {
  repeated [[.GoName]]Item items = 1;
  int64 total = 2;
  int32 page = 3;
  int32 page_size = 4;
}
