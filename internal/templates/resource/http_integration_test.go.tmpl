	notesbiz "[[.Module]]/internal/apiserver/biz/notes"
	noteshttp "[[.Module]]/internal/apiserver/handler/http/notes"
	notesstore "[[.Module]]/internal/apiserver/store/notes"
	[[if eq .Authz "casbin"]]"[[.Module]]/internal/pkg/authz"[[end]]
