[[if .Redis]]type generatedResourceDependency struct { calls int }
func (dependency *generatedResourceDependency) Check(ctx context.Context) error { dependency.calls++; return ctx.Err() }[[end]]

func TestGeneratedResourceHTTP(t *testing.T) {
	ctx := context.Background()
	db, err := database.Open(ctx, config.Database{Path:filepath.Join(t.TempDir(), "resources.db"), MaxOpen:4, MaxIdle:2, BusyTimeout:time.Second, SlowThreshold:time.Second}, zap.NewNop())
	if err != nil { t.Fatal(err) }; defer func(){ _ = db.Close() }()
	if err := db.Migrate(ctx); err != nil { t.Fatal(err) }
	orders := ordersstore.New(db.DB); notes := notesstore.New(db.DB)
	if err := orders.CheckSchema(ctx); err != nil { t.Fatal(err) }; if err := notes.CheckSchema(ctx); err != nil { t.Fatal(err) }
	[[if .Redis]]dependency := &generatedResourceDependency{}[[end]]
	[[if eq .Authz "casbin"]]catalog := authz.Catalog{"orders":{"create","read","update","delete"},"notes":{"create","read","update","delete"}}
	authorization, err := authz.New(ctx, authz.NewDatabase(db.DB,catalog),catalog); if err != nil { t.Fatal(err) }
	if err := authorization.Authorize(ctx,"Alice","orders","read"); err == nil { t.Fatal("empty policy allowed a request") }[[end]]
	secret := base64.StdEncoding.EncodeToString([]byte(strings.Repeat("s", 32)))
	jwt, err := auth.New(config.JWT{Secret:secret, Issuer:"test", Audience:"test-api", TTL:time.Minute}); if err != nil { t.Fatal(err) }
	alice, err := jwt.Issue("Alice", time.Minute); if err != nil { t.Fatal(err) }; bob, err := jwt.Issue("alice", time.Minute); if err != nil { t.Fatal(err) }
	modules := []HTTPModule{
		{Name:"orders", Path:"/v1/orders", Operations:map[string]string{"GET":"read","POST":"create","PATCH":"update","DELETE":"delete"}, Register:ordershttp.New(ordersbiz.New(orders[[if .Redis]],dependency[[end]])).Register},
		{Name:"notes", Path:"/v1/notes", Operations:map[string]string{"GET":"read","POST":"create","PATCH":"update","DELETE":"delete"}, Register:noteshttp.New(notesbiz.New(notes[[if .Redis]],dependency[[end]])).Register},
	}
	ready := &server.Readiness{CheckDependency:db.Pool.PingContext}
	router := NewRouter(config.HTTP{RequestTimeout:time.Second, MaxBodyBytes:4096}, ready, zap.NewNop(), jwt, modules[[if eq .Authz "casbin"]], authorization[[end]])
	server := httptest.NewServer(router); defer server.Close()
	request := func(method,path,body,token string) *httptest.ResponseRecorder { t.Helper(); req,err:=http.NewRequest(method,server.URL+path,strings.NewReader(body)); if err!=nil { t.Fatal(err) }; req.Header.Set("Content-Type","application/json"); if token!="" { req.Header.Set("Authorization","Bearer "+token) }; response,err:=server.Client().Do(req); if err!=nil { t.Fatal(err) }; defer func(){ _ = response.Body.Close() }(); result:=httptest.NewRecorder(); result.Code=response.StatusCode; payload,err:=io.ReadAll(response.Body); if err!=nil { t.Fatal(err) }; result.Body.Write(payload); return result }
	if response:=request(http.MethodGet,"/v1/orders", "", ""); response.Code!=http.StatusUnauthorized { t.Fatalf("missing JWT: %d",response.Code) }
	[[if eq .Authz "casbin"]]if response:=request(http.MethodGet,"/v1/orders","",alice);response.Code!=http.StatusForbidden{t.Fatalf("default deny: %d %s",response.Code,response.Body.String())}
	if err := authorization.Replace(ctx,[]authz.Rule{
		{Ptype:"p",V0:"role:resource_reader",V1:"orders",V2:"read"},
		{Ptype:"p",V0:"role:resource_reader",V1:"orders",V2:"update"},
		{Ptype:"p",V0:"role:resource_reader",V1:"orders",V2:"delete"},
		{Ptype:"p",V0:"role:resource_writer",V1:"orders",V2:"create"},
		{Ptype:"p",V0:"role:resource_writer",V1:"orders",V2:"read"},
		{Ptype:"p",V0:"role:resource_writer",V1:"orders",V2:"update"},
		{Ptype:"p",V0:"role:resource_writer",V1:"orders",V2:"delete"},
		{Ptype:"p",V0:"role:resource_writer",V1:"notes",V2:"create"},
		{Ptype:"p",V0:"role:resource_writer",V1:"notes",V2:"read"},
		{Ptype:"p",V0:"role:resource_writer",V1:"notes",V2:"update"},
		{Ptype:"p",V0:"role:resource_writer",V1:"notes",V2:"delete"},
		{Ptype:"g",V0:"user:Alice",V1:"role:resource_reader"},
		{Ptype:"g",V0:"user:alice",V1:"role:resource_writer"},
	}); err != nil { t.Fatal(err) }[[end]]
	guideBytes, err := os.ReadFile(filepath.Join("..","..","docs","orders.md")); if err != nil { t.Fatal(err) }
	guide := string(guideBytes); marker := "```sh\n"; start := strings.Index(guide,marker); if start < 0 { t.Fatal("curl example missing from resource guide") }; start += len(marker)
	end := strings.Index(guide[start:],"\n```"); if end < 0 { t.Fatal("curl example is not closed") }
	curlContext, cancelCurl := context.WithTimeout(ctx,3*time.Second); defer cancelCurl()
	curl := exec.CommandContext(curlContext,"sh","-c",guide[start:start+end])
	curlEnv := make([]string,0,len(os.Environ())+2); for _,entry := range os.Environ() { if strings.HasPrefix(entry,"API_URL=")||strings.HasPrefix(entry,"TOKEN="){continue}; curlEnv=append(curlEnv,entry) }; curl.Env=append(curlEnv,"API_URL="+server.URL,"TOKEN="+bob)
	if output, err := curl.CombinedOutput(); err != nil { t.Fatalf("run resource guide curl: %v: %s",err,output) }
	created := request(http.MethodPost,"/v1/orders",`[[.CreateJSON]]`,[[if eq .Authz "casbin"]]bob[[else]]alice[[end]])
	if created.Code!=http.StatusCreated { t.Fatalf("create orders: %d %s",created.Code,created.Body.String()) }
	[[if eq .Authz "casbin"]][[if .Redis]]callsBeforeDeniedRequest:=dependency.calls[[end]]
	if response:=request(http.MethodPost,"/v1/orders",`[[.CreateJSON]]`,alice);response.Code!=http.StatusForbidden{t.Fatalf("insufficient permission: %d %s",response.Code,response.Body.String())}
	[[if .Redis]]if dependency.calls!=callsBeforeDeniedRequest{t.Fatal("Redis dependency checked before authorization")}[[end]][[end]]
	var item struct { ID uint64 `json:"id"` }; if err:=json.Unmarshal(created.Body.Bytes(),&item);err!=nil||item.ID==0||strings.Contains(created.Body.String(),`"owner":`){t.Fatalf("invalid or private response: %s",created.Body.String())}
	path := "/v1/orders/"+strconv.FormatUint(item.ID,10)
	if response:=request(http.MethodGet,path,"",[[if eq .Authz "casbin"]]alice[[else]]bob[[end]]);response.Code!=http.StatusNotFound{t.Fatalf("cross-subject read: %d",response.Code)}
	patch := request(http.MethodPatch,path,`[[.ZeroJSON]]`,[[if eq .Authz "casbin"]]bob[[else]]alice[[end]]);if patch.Code!=http.StatusOK{t.Fatalf("zero-value update: %d %s",patch.Code,patch.Body.String())}
	if response:=request(http.MethodPost,"/v1/notes",`[[.CreateJSON]]`,[[if eq .Authz "casbin"]]bob[[else]]alice[[end]]);response.Code!=http.StatusCreated{t.Fatalf("create notes: %d %s",response.Code,response.Body.String())}
	for _,body:=range []string{`{"owner":"alice"}`,`{"[[ (index .Fields 0).Name ]]":null}`,`{"[[ (index .Fields 0).Name ]]":1,"[[ (index .Fields 0).Name ]]":2}`,`{"unknown":1}`} { if response:=request(http.MethodPost,"/v1/orders",body,[[if eq .Authz "casbin"]]bob[[else]]alice[[end]]);response.Code!=http.StatusBadRequest{t.Fatalf("invalid body %s: %d",body,response.Code)} }
	if response:=request(http.MethodDelete,path,"",[[if eq .Authz "casbin"]]alice[[else]]bob[[end]]);response.Code!=http.StatusNotFound{t.Fatalf("cross-subject delete: %d",response.Code)}
	if response:=request(http.MethodDelete,path,"",[[if eq .Authz "casbin"]]bob[[else]]alice[[end]]);response.Code!=http.StatusNoContent{t.Fatalf("delete: %d %s",response.Code,response.Body.String())}
}
