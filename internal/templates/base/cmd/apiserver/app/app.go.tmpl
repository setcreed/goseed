package app

import (
	"context"
	"crypto/rand"
	"encoding/base64"
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"strings"
	"time"

	"[[.Module]]/internal/apiserver/bootstrap"
	"[[.Module]]/internal/pkg/config"
 "[[.Module]]/internal/pkg/auth"
 [[if and (eq .Authz "casbin") (ne .Database "none")]]"[[.Module]]/internal/pkg/authz"[[end]]
	[[if ne .Database "none"]]"[[.Module]]/internal/pkg/database"
	logx "[[.Module]]/internal/pkg/log"[[end]]
)

func Run(ctx context.Context, args []string, output io.Writer, version string) error {
	command := "serve"
	action := ""
	if len(args)>0 && !strings.HasPrefix(args[0],"-") { command = args[0]; args = args[1:] }
	if command == "dev" {
		if len(args)==0 || (args[0]!="init" && args[0]!="token") { return errors.New("expected dev init or token") }; action=args[0];args = args[1:]
	} [[if ne .Database "none"]]else if command == "migrate" {
		if len(args)==0 || (args[0]!="up" && args[0]!="status") {return errors.New("expected migrate up or status")};action=args[0];args=args[1:]
	} [[end]][[if and (eq .Authz "casbin") (ne .Database "none")]]else if command=="policy" {if len(args)==0||args[0]!="replace"{return errors.New("expected policy replace")};action=args[0];args=args[1:]} [[end]]else if command != "serve" { return errors.New("unknown command") }
	flags := flag.NewFlagSet(command,flag.ContinueOnError); flags.SetOutput(io.Discard)
	filename := flags.String("config",config.DefaultPath,"configuration file")
	address := flags.String("address","","[[if eq .Transport "grpc"]]gRPC[[else]]HTTP[[end]] listen address")
	environment := flags.String("env","","runtime environment")
 var subject,lifetime string
 [[if and (eq .Authz "casbin") (ne .Database "none")]]var policyFile string;if command=="policy" {flags.StringVar(&policyFile,"file","","validated policy CSV to import")}[[end]]
 if command=="dev" && action=="token" {flags.StringVar(&subject,"subject","","token subject");flags.StringVar(&lifetime,"ttl","","token lifetime")}
	if err := flags.Parse(args); err != nil { if errors.Is(err,flag.ErrHelp) { _,err = fmt.Fprintln(output,"commands: serve [--config file] [--address host:port] [--env environment]; dev init [--config file]; dev token --subject value [--ttl duration] [--config file][[if ne .Database "none"]]; migrate up|status [--config file][[end]][[if and (eq .Authz "casbin") (ne .Database "none")]]; policy replace --file csv [--config file][[end]]"); return err }; return err }
	if flags.NArg()!=0 { return errors.New("unexpected arguments") }
	explicit := false; flags.Visit(func(f *flag.Flag){ if f.Name=="config" { explicit = true } })
	if command!="serve" && (*address!="" || *environment!="") {return errors.New("--address and --env only apply to serve")}
 if command=="dev" && action=="init" {return Init(*filename,output)}
 [[if and (eq .Authz "casbin") (ne .Database "none")]]if command=="policy"&&policyFile==""{return errors.New("policy replace requires --file") }[[end]]
	settings,err := config.Load(*filename,explicit,config.Overrides{Address:*address,Env:*environment})
	if err != nil { return err }
	if command=="dev" {
  if settings.Env!="development" {return errors.New("development token issuance is disabled in production")}
  ttl:=settings.JWT.TTL; if lifetime!="" {ttl,err=time.ParseDuration(lifetime);if err!=nil{return errors.New("invalid token lifetime")}}
  service,err:=auth.New(settings.JWT);if err!=nil{return err};token,err:=service.Issue(subject,ttl);if err!=nil{return err};_,err=fmt.Fprintln(output,token);return err
 }
 [[if ne .Database "none"]]if command=="migrate"[[if eq .Authz "casbin"]]||command=="policy"[[end]] {
		if *address!="" || *environment!="" {return errors.New("migrate only accepts --config")}
		logging,err:=logx.New(settings.Log,version);if err!=nil{return err};defer func(){_ = logging.Sync()}()
		migrationContext,cancel:=context.WithTimeout(ctx,time.Minute);defer cancel()
		db,err:=database.Open(migrationContext,settings.Database,logging);if err!=nil{return err};defer func(){_ = db.Close()}()
  [[if eq .Authz "casbin"]]if command=="policy"{if err:=db.CheckSchema(migrationContext);err!=nil{return err};if err:=authz.Import(migrationContext,authz.NewDatabase(db.DB),policyFile);err!=nil{return err};_,err=fmt.Fprintln(output,"policy replaced; restart running instances to load the new policy");return err}[[end]]
		if action=="up" {if err:=db.Migrate(migrationContext);err!=nil{return err}}
		version,err:=db.Version(migrationContext);if err!=nil{return err};_,err=fmt.Fprintf(output,"schema version: %d\n",version);return err
	}[[end]]
	application,err := bootstrap.New(settings,version)
	if err != nil { return err }
	return application.Run(ctx)
}

func Init(filename string, output io.Writer) error {
	if environment := os.Getenv("APP_ENV"); environment!="" && environment!="development" { return errors.New("development initialization is disabled in this environment") }
	if info,err := os.Lstat(filename); err == nil {
		if info.Mode()&os.ModeSymlink!=0 || !info.Mode().IsRegular() { return errors.New("development config must be a regular file") }
		settings,err := config.Load(filename,true,config.Overrides{})
		if err != nil { return err }; if settings.Env!="development" { return errors.New("development initialization requires development config") }
		_,err = fmt.Fprintln(output,"existing development configuration preserved"); return err
	} else if !errors.Is(err,os.ErrNotExist) { return errors.New("cannot inspect development configuration") }
	var key [32]byte
	if _,err := rand.Read(key[:]); err != nil { return err }
	if err := os.MkdirAll(filepath.Dir(filename),0750); err != nil { return errors.New("cannot create development config directory") }
	file,err := os.OpenFile(filename,os.O_WRONLY|os.O_CREATE|os.O_EXCL,0600)
	if err != nil { return errors.New("cannot create development configuration without overwrite") }
	content := fmt.Sprintf("env: development\nlog:\n  format: console\n[[if or (eq .Database "mysql") (eq .Database "postgres")]]database:\n  tls: false\n[[end]][[if .Redis]]redis:\n  tls: false\n[[end]]jwt:\n  secret: %q\n",base64.StdEncoding.EncodeToString(key[:]))
	_,writeError := file.WriteString(content); closeError := file.Close()
	if writeError!=nil || closeError!=nil { _ = os.Remove(filename); return errors.New("cannot write development configuration") }
	_,err = fmt.Fprintln(output,"development configuration created"); return err
}
