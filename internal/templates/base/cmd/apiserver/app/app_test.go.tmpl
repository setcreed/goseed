package app

import (
	"bytes"
	"context"
	"io"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestDevelopmentInitPreservesKeysAndRejectsProduction(t *testing.T) {
	[[if or (eq .Database "mysql") (eq .Database "postgres")]]t.Setenv("APP_DATABASE_PASSWORD","unit-test-placeholder")[[end]]
	filename:=filepath.Join(t.TempDir(),"app.yaml")
	var output bytes.Buffer
	if err:=Init(filename,&output); err!=nil { t.Fatal(err) }
	first,err:=os.ReadFile(filename); if err!=nil { t.Fatal(err) }
	info,err:=os.Stat(filename); if err!=nil || info.Mode().Perm()!=0600 { t.Fatalf("configuration permissions: %v",err) }
	if err:=Init(filename,&output); err!=nil { t.Fatal(err) }
	second,err:=os.ReadFile(filename); if err!=nil { t.Fatal(err) }; if !bytes.Equal(first,second) { t.Fatal("existing key changed") }
	t.Setenv("APP_ENV","production")
	if err:=Init(filepath.Join(t.TempDir(),"app.yaml"),&output); err==nil { t.Fatal("production init allowed") }
	if err:=Run(context.Background(),[]string{""},&output,"test"); err==nil { t.Fatal("empty command accepted") }
}

func TestDevTokenRequiresDevelopmentConfig(t *testing.T){
 [[if or (eq .Database "mysql") (eq .Database "postgres")]]t.Setenv("APP_DATABASE_PASSWORD","unit-test-placeholder")[[end]]
 directory:=t.TempDir();filename:=filepath.Join(directory,"app.yaml")
 if err:=Init(filename,io.Discard);err!=nil{t.Fatal(err)}
 var output bytes.Buffer
 if err:=Run(context.Background(),[]string{"dev","token","--config",filename,"--subject","alice","--ttl","1m"},&output,"test");err!=nil{t.Fatal(err)}
 if len(strings.Split(strings.TrimSpace(output.String()),"."))!=3{t.Fatal("token output")}
 for _,args:=range [][]string{{"dev","token","--config",filename},{"dev","token","--config",filename,"--subject","alice","--ttl","2h"}}{if err:=Run(context.Background(),args,io.Discard,"test");err==nil{t.Fatal("invalid token arguments accepted")}}
 t.Setenv("APP_ENV","production");t.Setenv("APP_LOG_FORMAT","json")
 if err:=Run(context.Background(),[]string{"dev","token","--config",filename,"--subject","alice"},io.Discard,"test");err==nil{t.Fatal("production issued development token")}
}

func TestDevelopmentInitDoesNotOverwriteInvalidFileOrSymlink(t *testing.T){
 directory:=t.TempDir();filename:=filepath.Join(directory,"app.yaml")
 content:=[]byte("env: production\njwt:\n  secret: invalid\n")
 if err:=os.WriteFile(filename,content,0600);err!=nil{t.Fatal(err)}
 if err:=Init(filename,io.Discard);err==nil{t.Fatal("invalid production config accepted")}
 after,err:=os.ReadFile(filename);if err!=nil||!bytes.Equal(content,after){t.Fatal("existing invalid config overwritten")}
 link:=filepath.Join(directory,"linked.yaml");if err:=os.Symlink(filename,link);err!=nil{t.Fatal(err)}
 if err:=Init(link,io.Discard);err==nil{t.Fatal("symlink accepted")}
}
