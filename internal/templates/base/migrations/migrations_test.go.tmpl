package migrations

import (
 "slices"
 "testing"
 "testing/fstest"
)

func TestEmbeddedMigrationVersions(t *testing.T){
 values,err:=Versions();if err!=nil{t.Fatal(err)}
 expected,err:=ExpectedVersion();if err!=nil||expected!=values[len(values)-1]{t.Fatal("expected version differs from SQL files",err)}
 values[0]=999
 fresh,err:=Versions();if err!=nil||fresh[0]!=1{t.Fatal("caller changed version registry",err)}
 source:=fstest.MapFS{"00100_Custom.sql":{Data:[]byte("-- draft")},"00001_base.sql":{Data:[]byte("-- draft")}}
 actual,err:=versions(source);if err!=nil||!slices.Equal(actual,[]int64{1,100}){t.Fatal("nonconsecutive versions are not stable",actual,err)}
 for _,files:=range [][]string{{},{"bad.sql"},{"00000_zero.sql"},{"9223372036854775808_large.sql"},{"00001_a.sql","1_b.sql"}} {
  invalid:=make(fstest.MapFS);for _,name:=range files{invalid[name]=&fstest.MapFile{Data:[]byte("-- draft")}}
  if _,err:=versions(invalid);err==nil{t.Fatal("invalid versions accepted",files)}
 }
}
