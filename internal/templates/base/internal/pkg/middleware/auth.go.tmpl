package middleware

import (
 "strings"

 "[[.Module]]/internal/pkg/auth"
 "[[.Module]]/internal/pkg/contextx"
 "[[.Module]]/internal/pkg/errno"
 "github.com/gin-gonic/gin"
)
func Authenticate(service *auth.JWT)gin.HandlerFunc{
 return func(c *gin.Context){
  if err:=c.Request.Context().Err();err!=nil{Failure(c,err);return}
  headers:=c.Request.Header.Values("Authorization")
  if len(headers)!=1{Failure(c,errno.Unauthorized);return}
  parts:=strings.Fields(headers[0]);if len(parts)!=2||!strings.EqualFold(parts[0],"Bearer"){Failure(c,errno.Unauthorized);return}
  subject,err:=service.Parse(parts[1]);if err!=nil{Failure(c,err);return}
  c.Request=c.Request.WithContext(contextx.WithSubject(c.Request.Context(),subject));c.Next()
 }
}
