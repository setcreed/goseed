package middleware

import (
 "encoding/base64"
 "net/http/httptest"
 "strings"
 "testing"
 "time"

 "[[.Module]]/internal/pkg/auth"
 "[[.Module]]/internal/pkg/config"
 "[[.Module]]/internal/pkg/contextx"
 "github.com/gin-gonic/gin"
)
func TestAuthenticationBoundary(t *testing.T){
 service,err:=auth.New(config.JWT{Secret:base64.StdEncoding.EncodeToString(make([]byte,32)),Issuer:"demo",Audience:"api",TTL:time.Minute});if err!=nil{t.Fatal(err)}
 token,err:=service.Issue("alice",time.Minute);if err!=nil{t.Fatal(err)}
 gin.SetMode(gin.ReleaseMode);router:=gin.New();router.Use(RequestID(),Authenticate(service));router.GET("/private",func(c *gin.Context){if contextx.Subject(c.Request.Context())!="alice"{t.Error("subject not propagated")};c.Status(204)})
 cases:=[]struct{header []string;status int}{{nil,401},{[]string{"Basic "+token},401},{[]string{"Bearer invalid"},401},{[]string{"Bearer "+token,"Bearer "+token},401},{[]string{"bearer "+token},204}}
 for _,test:=range cases{request:=httptest.NewRequest("GET","/private",nil);for _,header:=range test.header{request.Header.Add("Authorization",header)};response:=httptest.NewRecorder();router.ServeHTTP(response,request);if response.Code!=test.status{t.Fatalf("status %d want %d",response.Code,test.status)};if strings.Contains(response.Body.String(),token){t.Fatal("token leaked")}}
}
