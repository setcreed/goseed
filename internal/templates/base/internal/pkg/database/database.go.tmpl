type Database struct { DB *gorm.DB; Pool *sql.DB }

[[if eq .Database "sqlite"]]func Open(ctx context.Context, settings config.Database, logging *zap.Logger) (*Database,error) {
 filename,err:=filepath.Abs(settings.Path); if err!=nil {return nil,errors.New("invalid database path")}
 if err:=os.MkdirAll(filepath.Dir(filename),0750);err!=nil{return nil,errors.New("cannot create database directory")}
 if info,err:=os.Lstat(filename);err==nil {if !info.Mode().IsRegular(){return nil,errors.New("database must be a regular file")}} else if !errors.Is(err,os.ErrNotExist){return nil,errors.New("cannot inspect database file")}
 file,err:=os.OpenFile(filename,os.O_CREATE|os.O_RDWR,0600);if err!=nil{return nil,errors.New("cannot open database file")};if err:=file.Close();err!=nil{return nil,errors.New("cannot close database file")}
 uri:=url.URL{Scheme:"file",Path:filename};query:=url.Values{}
 query.Add("_pragma","foreign_keys(1)");query.Add("_pragma",fmt.Sprintf("busy_timeout(%d)",settings.BusyTimeout.Milliseconds()));query.Add("_pragma","journal_mode(WAL)");uri.RawQuery=query.Encode()
 db,err:=gorm.Open(sqlite.Open(uri.String()),&gorm.Config{TranslateError:true,Logger:queryLogger{logging,settings.SlowThreshold},NowFunc:func()time.Time{return time.Now().UTC()}})
 if err!=nil{return nil,errors.New("cannot initialize SQLite")}
 pool,err:=db.DB();if err!=nil{return nil,errors.New("cannot obtain database pool")}
 pool.SetMaxOpenConns(settings.MaxOpen);pool.SetMaxIdleConns(settings.MaxIdle)
 if err:=pool.PingContext(ctx);err!=nil{_ = pool.Close();return nil,errors.New("database ping failed")}
 return &Database{DB:db,Pool:pool},nil
}
[[end]]

func (d *Database) Close() error {return d.Pool.Close()}

// Version only reads: it must not create Goose's bookkeeping table.
func (d *Database) Version(ctx context.Context)(int64,error){
 versions,err:=d.appliedVersions(ctx);if err!=nil{return 0,err};if len(versions)==0{return 0,nil};return versions[len(versions)-1],nil
}
func migrationStatusError(ctx context.Context)error{if err:=ctx.Err();err!=nil{return err};return errors.New("cannot read migration status")}
func(d *Database)appliedVersions(ctx context.Context)([]int64,error){
 if err:=ctx.Err();err!=nil{return nil,err}
 var exists int
 if err:=d.Pool.QueryRowContext(ctx,[[if eq .Database "sqlite"]]"SELECT count(*) FROM sqlite_master WHERE type='table' AND name='goose_db_version'"[[else if eq .Database "mysql"]]"SELECT count(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name='goose_db_version'"[[else]]"SELECT count(*) FROM information_schema.tables WHERE table_schema=current_schema() AND table_name='goose_db_version'"[[end]]).Scan(&exists);err!=nil{return nil,migrationStatusError(ctx)}
 if exists==0{return nil,nil}
 rows,err:=d.Pool.QueryContext(ctx,"SELECT version_id,is_applied FROM goose_db_version ORDER BY id");if err!=nil{return nil,migrationStatusError(ctx)};defer func(){_ = rows.Close()}()
 applied:=make(map[int64]bool)
 for rows.Next(){var version int64;var active bool;if err:=rows.Scan(&version,&active);err!=nil{return nil,migrationStatusError(ctx)};if version<0{return nil,errors.New("invalid migration history")};if version>0{applied[version]=active}}
 if err:=rows.Err();err!=nil{return nil,migrationStatusError(ctx)}
 values:=make([]int64,0,len(applied));for version,active:=range applied{if active{values=append(values,version)}};slices.Sort(values);return values,nil
}
func (d *Database) CheckSchema(ctx context.Context)error{
 expected,err:=migrations.Versions();if err!=nil{return err};applied,err:=d.appliedVersions(ctx);if err!=nil{return err};if !slices.Equal(applied,expected){return errors.New("database migration history is not ready; inspect history and run migrate up")}
 // Check the actual schema as well as its recorded version without writing.
 if err:=d.DB.WithContext(ctx).Exec("SELECT id,owner,name,description,enabled,created_at,updated_at FROM examples LIMIT 0").Error;err!=nil{if ctx.Err()!=nil{return ctx.Err()};return errors.New("database schema is not ready; run migrate up")}
 [[if eq .Authz "casbin"]]if err:=d.DB.WithContext(ctx).Exec("SELECT id,ptype,v0,v1,v2 FROM casbin_rules LIMIT 0").Error;err!=nil{if ctx.Err()!=nil{return ctx.Err()};return errors.New("policy schema is not ready; run migrate up")}[[end]]
 return nil
}
func (d *Database) Migrate(ctx context.Context)error{
 expected,err:=migrations.Versions();if err!=nil{return err};applied,err:=d.appliedVersions(ctx);if err!=nil{return err}
 if len(applied)>len(expected)||!slices.Equal(applied,expected[:len(applied)]){return errors.New("database migration history is incompatible; explicit repair is required")}
 provider,err:=goose.NewProvider(goose.[[if eq .Database "sqlite"]]DialectSQLite3[[else if eq .Database "mysql"]]DialectMySQL[[else]]DialectPostgres[[end]],d.Pool,migrations.Files,goose.WithDisableGlobalRegistry(true),goose.WithLogger(quietLogger{}));if err!=nil{return errors.New("cannot initialize migrations")}
 if _,err:=provider.Up(ctx);err!=nil{if ctx.Err()!=nil{return ctx.Err()};return errors.New("database migration failed; inspect partial schema and history before retrying")};return d.CheckSchema(ctx)
}

type quietLogger struct{}
func (quietLogger) Printf(string,...any){}
func (quietLogger) Fatalf(string,...any){}

type queryLogger struct{logging *zap.Logger;slow time.Duration}
func(q queryLogger)LogMode(logger.LogLevel)logger.Interface{return q}
func(q queryLogger)Info(context.Context,string,...any){}
func(q queryLogger)Warn(context.Context,string,...any){}
func(q queryLogger)Error(context.Context,string,...any){}
func(q queryLogger)Trace(ctx context.Context,begin time.Time,_ func()(string,int64),err error){
 elapsed:=time.Since(begin)
 fields:=[]zap.Field{zap.Duration("duration",elapsed),zap.String("request_id",contextx.RequestID(ctx))}
 if err!=nil && !errors.Is(err,gorm.ErrRecordNotFound){q.logging.Error("database query failed",fields...)}else if elapsed>=q.slow{q.logging.Warn("slow database query",fields...)}
}
