package config

import (
	"encoding/base64"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestConfigurationBoundary(t *testing.T) {
	[[if eq .Transport "dual"]]t.Setenv("APP_GRPC_TLS_CERT","configuration-only-cert");t.Setenv("APP_GRPC_TLS_KEY","configuration-only-key")[[end]]
	[[if or (eq .Database "mysql") (eq .Database "postgres")]]t.Setenv("APP_DATABASE_PASSWORD","unit-test-placeholder")[[end]]
	[[if .Redis]]t.Setenv("APP_REDIS_PASSWORD","unit-test-placeholder");t.Setenv("APP_REDIS_ADDRESS","127.0.0.1:1")[[end]]
 t.Setenv("APP_JWT_SECRET", base64.StdEncoding.EncodeToString([]byte(strings.Repeat("s",32))))
	filename := filepath.Join(t.TempDir(), "app.yaml")
	if err := os.WriteFile(filename, []byte("http:\n  address: 127.0.0.1:8001\n"), 0600); err != nil { t.Fatal(err) }
	t.Setenv("APP_HTTP_ADDRESS", "127.0.0.1:8002")
	config, err := Load(filename, true, Overrides{Address:"127.0.0.1:8003"})
	if err != nil || config.HTTP.Address != "127.0.0.1:8003" { t.Fatalf("override precedence: %v",err) }
	config, err = Load(filepath.Join(t.TempDir(),"absent.yaml"), false, Overrides{})
	if err != nil || config.HTTP.Address != "127.0.0.1:8002" { t.Fatalf("environment-only: %v",err) }
	if _, err := Load(filepath.Join(t.TempDir(),"absent.yaml"), true, Overrides{}); err == nil { t.Fatal("explicit absent config accepted") }
	for _, input := range []string{"unknown: value\n", "http:\n  request_timeout: 5\n", "http:\n  pprof: true\n", "jwt:\n  ttl: 2h\n", "env: invalid\n", "jwt:\n  issuer: 123\n", "database:\n  max_open: 4.5\n", "http:\n  pprof: 0\n"} {
		if err := os.WriteFile(filename, []byte(input),0600); err != nil { t.Fatal(err) }
		if _, err := Load(filename,true,Overrides{}); err == nil { t.Fatalf("invalid configuration accepted: %s",input) }
	}
	t.Setenv("APP_JWT_SECRET", "test-secret-must-not-appear")
	if err := os.WriteFile(filename,[]byte("{}\n"),0600); err != nil { t.Fatal(err) }
	if _, err := Load(filename,true,Overrides{}); err == nil || strings.Contains(err.Error(),"test-secret-must-not-appear") { t.Fatal("missing validation or secret disclosure") }
}
[[if or (eq .Database "mysql") (eq .Database "postgres")]]
func TestExternalDatabaseConfiguration(t *testing.T){
 [[if eq .Transport "dual"]]t.Setenv("APP_GRPC_TLS_CERT","configuration-only-cert");t.Setenv("APP_GRPC_TLS_KEY","configuration-only-key")[[end]]
 t.Setenv("APP_JWT_SECRET",base64.StdEncoding.EncodeToString(make([]byte,32)))
 t.Setenv("APP_DATABASE_PASSWORD","unit-test-placeholder")
 filename:=filepath.Join(t.TempDir(),"app.yaml")
 for _,input:=range []string{
  "database:\n  path: app.db\n", "database:\n  tls: false\n", "database:\n  port: 0\n", "database:\n  host: bad/host\n",
  "database:\n  connect_timeout: 0s\n", "database:\n  conn_max_idle_time: 1h\n", "database:\n  name: ''\n", "database:\n  tls: 1\n",
  "env: development\ndatabase:\n  tls: false\n  ca_file: private-ca.pem\n",
 }{if err:=os.WriteFile(filename,[]byte(input),0600);err!=nil{t.Fatal(err)};if _,err:=Load(filename,true,Overrides{});err==nil{t.Fatal("invalid database config accepted")}}
 if err:=os.WriteFile(filename,[]byte("env: development\ndatabase:\n  tls: false\n"),0600);err!=nil{t.Fatal(err)}
 if _,err:=Load(filename,true,Overrides{});err!=nil{t.Fatal(err)}
 t.Setenv("APP_DATABASE_PASSWORD","");if _,err:=Load(filename,true,Overrides{});err==nil{t.Fatal("missing password accepted")}
}
[[end]]
