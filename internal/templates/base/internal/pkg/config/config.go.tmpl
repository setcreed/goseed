package config

import (
	"encoding/base64"
	"errors"
	"fmt"
	"net"
	"net/url"
	"os"
	"strings"
	"time"

	"github.com/spf13/viper"
)

const DefaultPath = "configs/app.yaml"

type Config struct {
	Env string
	HTTP HTTP
	Log Log
	[[if ne .Database "none"]]Database Database[[end]]
	JWT JWT
	[[if .Redis]]Redis Redis[[end]]
}

type HTTP struct {
	Address string
	ReadHeaderTimeout time.Duration `mapstructure:"read_header_timeout"`
	ReadTimeout time.Duration `mapstructure:"read_timeout"`
	WriteTimeout time.Duration `mapstructure:"write_timeout"`
	IdleTimeout time.Duration `mapstructure:"idle_timeout"`
	RequestTimeout time.Duration `mapstructure:"request_timeout"`
	ShutdownTimeout time.Duration `mapstructure:"shutdown_timeout"`
	MaxBodyBytes int64 `mapstructure:"max_body_bytes"`
	MaxHeaderBytes int `mapstructure:"max_header_bytes"`
	AllowedOrigins []string `mapstructure:"allowed_origins"`
	TLSCert string `mapstructure:"tls_cert"`
	TLSKey string `mapstructure:"tls_key"`
	Pprof bool
}

type Log struct { Level string; Format string }
[[if ne .Database "none"]]type Database struct {
	[[if eq .Database "sqlite"]]
	Path string
	BusyTimeout time.Duration `mapstructure:"busy_timeout"`
	[[else]]
	Host string
	Port int
	User string
	Password string
	Name string
	TLS bool
	CAFile string `mapstructure:"ca_file"`
	ConnectTimeout time.Duration `mapstructure:"connect_timeout"`
	ConnMaxLifetime time.Duration `mapstructure:"conn_max_lifetime"`
	ConnMaxIdleTime time.Duration `mapstructure:"conn_max_idle_time"`
	[[end]]
	MaxOpen int `mapstructure:"max_open"`
	MaxIdle int `mapstructure:"max_idle"`
	SlowThreshold time.Duration `mapstructure:"slow_threshold"`
}[[end]]
type JWT struct { Secret string; Issuer string; Audience string; TTL time.Duration }
[[if .Redis]]type Redis struct {
 Address string
 Username string
 Password string
 DB int
 KeyPrefix string `mapstructure:"key_prefix"`
 TTL time.Duration
 CommandTimeout time.Duration `mapstructure:"command_timeout"`
 DialTimeout time.Duration `mapstructure:"dial_timeout"`
 PoolSize int `mapstructure:"pool_size"`
 Required bool
 TLS bool
 CAFile string `mapstructure:"ca_file"`
}[[end]]
type Overrides struct { Address string; Env string }

func Load(filename string, explicit bool, overrides Overrides) (Config, error) {
	v := viper.New()
	v.SetConfigFile(filename)
	v.SetConfigType("yaml")
	defaults := map[string]any{
		"env": "production", "http.address": "127.0.0.1:8080",
		"http.read_header_timeout": "5s", "http.read_timeout": "15s", "http.write_timeout": "15s",
		"http.idle_timeout": "60s", "http.request_timeout": "5s", "http.shutdown_timeout": "10s",
		"http.max_body_bytes": 1048576, "http.max_header_bytes": 1048576,
		"http.allowed_origins": []string{}, "http.tls_cert": "", "http.tls_key": "", "http.pprof": false,
		"log.level": "info", "log.format": "json",
		[[if ne .Database "none"]][[if eq .Database "sqlite"]]"database.path": "data/app.db", "database.busy_timeout": "5s",[[else]]
		"database.host": "127.0.0.1", "database.port": [[if eq .Database "mysql"]]3306[[else]]5432[[end]],
		"database.user": "[[.Name]]", "database.password": "", "database.name": "[[.Name]]",
		"database.tls": true, "database.ca_file": "", "database.connect_timeout": "5s",
		"database.conn_max_lifetime": "30m", "database.conn_max_idle_time": "5m",[[end]]
		"database.max_open": 4, "database.max_idle": 2, "database.slow_threshold": "200ms",[[end]]
		"jwt.secret": "", "jwt.issuer": "[[.Name]]", "jwt.audience": "[[.Name]]-api", "jwt.ttl": "15m",
		[[if .Redis]]"redis.address":"127.0.0.1:6379","redis.username":"","redis.password":"","redis.db":0,"redis.key_prefix":"[[.Name]]","redis.ttl":"30s","redis.command_timeout":"200ms","redis.dial_timeout":"1s","redis.pool_size":4,"redis.required":false,"redis.tls":true,"redis.ca_file":"",[[end]]
	}
	for key, value := range defaults {
		v.SetDefault(key, value)
	}
	if err := v.ReadInConfig(); err != nil {
		if explicit || !errors.Is(err, os.ErrNotExist) { return Config{}, fmt.Errorf("cannot read configuration file %q", filename) }
	}
	for _, key := range v.AllKeys() { if _, exists := defaults[key]; !exists { return Config{}, fmt.Errorf("unknown configuration key %q", key) } }
	// Validate YAML before binding environment strings: weak decoding must not silently change file types.
	for key, expected := range defaults {
		value:=v.Get(key);valid:=false
		switch expected.(type){
		case string:_,valid=value.(string)
		case int:_,valid=value.(int)
		case bool:_,valid=value.(bool)
		case []string:
			switch entries:=value.(type){case []string:valid=true;case []any:valid=true;for _,entry:=range entries{if _,ok:=entry.(string);!ok{valid=false;break}}}
		}
		if !valid{return Config{},fmt.Errorf("invalid configuration type for %s",key)}
	}
	for key:=range defaults {if err:=v.BindEnv(key,"APP_"+strings.ToUpper(strings.ReplaceAll(key,".","_")));err!=nil{return Config{},errors.New("cannot bind configuration environment")}}
	for _, key := range []string{"http.read_header_timeout","http.read_timeout","http.write_timeout","http.idle_timeout","http.request_timeout","http.shutdown_timeout",[[if ne .Database "none"]][[if eq .Database "sqlite"]]"database.busy_timeout",[[else]]"database.connect_timeout","database.conn_max_lifetime","database.conn_max_idle_time",[[end]]"database.slow_threshold",[[end]]"jwt.ttl"[[if .Redis]],"redis.ttl","redis.command_timeout","redis.dial_timeout"[[end]]} {
		value, ok := v.Get(key).(string)
		if !ok { return Config{}, fmt.Errorf("%s requires a duration string with units",key) }
		if _, err := time.ParseDuration(value); err != nil { return Config{}, fmt.Errorf("invalid duration for %s",key) }
	}
	if overrides.Address != "" { v.Set("http.address", overrides.Address) }
	if overrides.Env != "" { v.Set("env", overrides.Env) }
	var config Config
	if err := v.UnmarshalExact(&config); err != nil { return Config{}, errors.New("invalid configuration field types; durations require units") }
	if err := config.Validate(); err != nil { return Config{}, err }
	return config, nil
}

func (c Config) Validate() error {
	if c.Env != "development" && c.Env != "production" { return errors.New("env must be development or production") }
	host, port, err := net.SplitHostPort(c.HTTP.Address)
	if err != nil || host == "" || port == "" { return errors.New("http.address requires host and port") }
	if _, err := net.LookupPort("tcp", port); err != nil { return errors.New("invalid http.address port") }
	if c.HTTP.ReadHeaderTimeout <= 0 || c.HTTP.ReadTimeout < c.HTTP.ReadHeaderTimeout || c.HTTP.RequestTimeout <= 0 || c.HTTP.WriteTimeout <= c.HTTP.RequestTimeout || c.HTTP.IdleTimeout <= 0 || c.HTTP.ShutdownTimeout <= 0 { return errors.New("invalid HTTP timeouts; write timeout must exceed request timeout") }
	for _, duration := range []time.Duration{c.HTTP.ReadHeaderTimeout,c.HTTP.ReadTimeout,c.HTTP.WriteTimeout,c.HTTP.RequestTimeout,c.HTTP.IdleTimeout,c.HTTP.ShutdownTimeout} { if duration > 10*time.Minute { return errors.New("HTTP timeouts must not exceed 10m") } }
	if c.HTTP.MaxBodyBytes < 1 || c.HTTP.MaxBodyBytes > 16<<20 || c.HTTP.MaxHeaderBytes < 1024 || c.HTTP.MaxHeaderBytes > 4<<20 { return errors.New("invalid HTTP body/header limits") }
	if (c.HTTP.TLSCert == "") != (c.HTTP.TLSKey == "") { return errors.New("TLS cert and key must be supplied together") }
	if c.HTTP.Pprof && (c.Env != "development" || (host != "localhost" && !net.ParseIP(host).IsLoopback())) { return errors.New("pprof requires development and a loopback address") }
	for _, origin := range c.HTTP.AllowedOrigins {
		u, err := url.Parse(origin)
		if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" || u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" { return errors.New("allowed_origins requires exact HTTP origins") }
	}
	if c.Log.Level != "debug" && c.Log.Level != "info" && c.Log.Level != "warn" && c.Log.Level != "error" { return errors.New("invalid log.level") }
	if c.Log.Format != "json" && c.Log.Format != "console" { return errors.New("invalid log.format") }
	if c.Env == "production" && c.Log.Format != "json" { return errors.New("production requires JSON logs") }
	[[if ne .Database "none"]][[if eq .Database "sqlite"]]
	if c.Database.Path == "" || strings.ContainsAny(c.Database.Path, "\x00\r\n") || c.Database.Path == ":memory:" { return errors.New("database.path requires a persistent file") }
	if c.Database.BusyTimeout < time.Millisecond || c.Database.BusyTimeout > 30*time.Second {return errors.New("invalid database busy timeout")}
	[[else]]
	if c.Database.Host=="" || strings.TrimSpace(c.Database.Host)!=c.Database.Host || strings.ContainsAny(c.Database.Host,"\x00\r\n/\\:@? ") && net.ParseIP(c.Database.Host)==nil || c.Database.Port<1 || c.Database.Port>65535 {return errors.New("invalid database host or port")}
	for _,value:=range []string{c.Database.User,c.Database.Name}{if strings.TrimSpace(value)=="" || strings.TrimSpace(value)!=value || strings.ContainsAny(value,"\x00\r\n"){return errors.New("database user and name are required")}}
	if c.Database.Password=="" || strings.ContainsRune(c.Database.Password,'\x00'){return errors.New("database password is required")}
	if !c.Database.TLS && (c.Env=="production" || c.Database.CAFile!=""){return errors.New("database TLS is required in production; CA requires TLS")}
	if c.Database.ConnectTimeout<time.Second || c.Database.ConnectTimeout>30*time.Second || c.Database.ConnMaxLifetime<=0 || c.Database.ConnMaxIdleTime<=0 || c.Database.ConnMaxIdleTime>c.Database.ConnMaxLifetime {return errors.New("invalid database connection timeouts")}
	[[end]]
	if c.Database.MaxOpen < 1 || c.Database.MaxOpen > 64 || c.Database.MaxIdle < 0 || c.Database.MaxIdle > c.Database.MaxOpen || c.Database.SlowThreshold <= 0 { return errors.New("invalid database connection settings") }[[end]]
	key, err := base64.StdEncoding.Strict().DecodeString(c.JWT.Secret)
	if err != nil || len(key) < 32 { return errors.New("jwt.secret requires Base64 encoding of at least 32 bytes") }
	if strings.TrimSpace(c.JWT.Issuer) == "" || strings.TrimSpace(c.JWT.Audience) == "" || c.JWT.TTL < time.Second || c.JWT.TTL > time.Hour { return errors.New("invalid jwt issuer, audience or ttl") }
	[[if .Redis]]if err:=c.Redis.Validate(c.Env,c.HTTP.RequestTimeout);err!=nil{return err}[[end]]
	return nil
}
