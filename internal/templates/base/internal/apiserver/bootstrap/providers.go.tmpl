type App struct { Server *server.Server; Logger *zap.Logger[[if eq .Transport "dual"]];RPC *rpc.Server;Dual *dual.Server[[end]][[if ne .Database "none"]];Database *database.Database[[end]][[if .Redis]];Cache *cache.Client[[end]][[if eq .Authz "casbin"]];Authorization *authz.Manager[[end]] }

func New(settings config.Config, version string) (*App,error) {
	logger,err := logx.New(settings.Log,version)
	if err != nil { return nil,err }
	[[if or (ne .Database "none") .Redis (eq .Authz "casbin")]]startup,cancel:=context.WithTimeout(context.Background(),10*time.Second);defer cancel()[[end]]
	[[if ne .Database "none"]]db,err:=database.Open(startup,settings.Database,logger)
	if err!=nil { _ = logger.Sync(); return nil,err }
	if err:=db.CheckSchema(startup);err!=nil {_ = db.Close(); _ = logger.Sync(); return nil,err}[[end]]
	injector := do.New()
	do.ProvideValue(injector,settings)
	do.ProvideValue(injector,logger)
	[[if ne .Database "none"]]do.ProvideValue(injector,db)[[end]]
	authentication,err:=auth.New(settings.JWT);if err!=nil{[[if ne .Database "none"]]_ = db.Close();[[end]] _ = logger.Sync();return nil,err}
	[[if eq .Authz "casbin"]]authorization,err:=authz.New(startup,authz.[[if eq .Database "none"]]NewFile(settings.Authz.PolicyFile)[[else]]NewDatabase(db.DB)[[end]]);if err!=nil{[[if ne .Database "none"]]_ = db.Close();[[end]]_ = logger.Sync();return nil,err}
	do.ProvideValue(injector,authorization)[[end]]
	[[if .Redis]]caching,err:=cache.Open(startup,settings.Redis,logger);if err!=nil{[[if ne .Database "none"]]_ = db.Close();[[end]]_ = logger.Sync();return nil,err}
	do.ProvideValue(injector,caching)[[end]]
	do.ProvideValue(injector,authentication)
	business:=examplebiz.[[if .Redis]]NewCached([[if ne .Database "none"]]examplestore.New(db.DB),[[end]]caching)[[else]]New([[if ne .Database "none"]]examplestore.New(db.DB)[[end]])[[end]]
	do.ProvideValue(injector,examplehandler.New(business))
	checkDependency:=func(ctx context.Context)error{[[if ne .Database "none"]]if err:=db.Pool.PingContext(ctx);err!=nil{return err};[[end]][[if .Redis]]return caching.Check(ctx)[[else]]return ctx.Err()[[end]]}
	httpReady:=&server.Readiness{CheckDependency:checkDependency}
	do.ProvideValue(injector,httpReady)
	do.Provide(injector,func(i do.Injector)(*server.Server,error){
		configuration,err := do.Invoke[config.Config](i); if err != nil { return nil,err }
		logging,err := do.Invoke[*zap.Logger](i); if err != nil { return nil,err }
		ready,err := do.Invoke[*server.Readiness](i); if err != nil { return nil,err }
		authentication,err:=do.Invoke[*auth.JWT](i);if err!=nil{return nil,err}
		examples,err:=do.Invoke[*examplehandler.Handler](i);if err!=nil{return nil,err}
		[[if eq .Authz "casbin"]]authorization,err:=do.Invoke[*authz.Manager](i);if err!=nil{return nil,err}[[end]]
		return server.New(apiserver.NewRouter(configuration.HTTP,ready,logging,authentication,examples[[if eq .Authz "casbin"]],authorization[[end]]),configuration.HTTP,ready,logging)
	})
	httpServer,err := do.Invoke[*server.Server](injector)
	if err != nil { [[if .Redis]]_ = caching.Close();[[end]][[if ne .Database "none"]]_ = db.Close();[[end]] _ = logger.Sync(); return nil,err }
	[[if eq .Transport "dual"]]rpcReady:=&rpc.Readiness{CheckDependency:checkDependency}
	examples:=rpchandler.New(business)
	rpcServer,err:=rpc.New(settings.GRPC,rpcReady,logger,authentication,rpchandler.Permissions,examples.Register[[if eq .Authz "casbin"]],authorization[[end]])
	if err!=nil{[[if .Redis]]_ = caching.Close();[[end]][[if ne .Database "none"]]_ = db.Close();[[end]]_ = logger.Sync();return nil,err}[[end]]
	return &App{Server:httpServer,Logger:logger,[[if eq .Transport "dual"]]RPC:rpcServer,Dual:dual.New(settings,httpServer,rpcServer,httpReady,rpcReady),[[end]][[if ne .Database "none"]]Database:db,[[end]][[if .Redis]]Cache:caching,[[end]][[if eq .Authz "casbin"]]Authorization:authorization,[[end]]},nil
}

func (a *App) Run(ctx context.Context) error { [[if eq .Transport "dual"]]rpc.InstallProtocolLogger(a.Logger);[[end]]defer func(){ [[if .Redis]]_ = a.Cache.Close();[[end]][[if ne .Database "none"]]_ = a.Database.Close();[[end]] _ = a.Logger.Sync() }(); return a.[[if eq .Transport "dual"]]Dual[[else]]Server[[end]].Run(ctx) }
