type App struct { Server *server.Server; Logger *zap.Logger; [[if ne .Database "none"]]Database *database.Database[[end]] }

func New(settings config.Config, version string) (*App,error) {
	logger,err := logx.New(settings.Log,version)
	if err != nil { return nil,err }
	[[if ne .Database "none"]]startup,cancel:=context.WithTimeout(context.Background(),10*time.Second);defer cancel()
	db,err:=database.Open(startup,settings.Database,logger)
	if err!=nil { _ = logger.Sync(); return nil,err }
	if err:=db.CheckSchema(startup);err!=nil {_ = db.Close(); _ = logger.Sync(); return nil,err}[[end]]
	injector := do.New()
	do.ProvideValue(injector,settings)
	do.ProvideValue(injector,logger)
	[[if ne .Database "none"]]do.ProvideValue(injector,db)[[end]]
	authentication,err:=auth.New(settings.JWT);if err!=nil{[[if ne .Database "none"]]_ = db.Close();[[end]] _ = logger.Sync();return nil,err}
	do.ProvideValue(injector,authentication)
	do.ProvideValue(injector,examplehandler.New(examplebiz.New([[if ne .Database "none"]]examplestore.New(db.DB)[[end]])))
	do.ProvideValue(injector,&server.Readiness{[[if ne .Database "none"]]CheckDependency:db.Pool.PingContext[[end]]})
	do.Provide(injector,func(i do.Injector)(*server.Server,error){
		configuration,err := do.Invoke[config.Config](i); if err != nil { return nil,err }
		logging,err := do.Invoke[*zap.Logger](i); if err != nil { return nil,err }
		ready,err := do.Invoke[*server.Readiness](i); if err != nil { return nil,err }
		authentication,err:=do.Invoke[*auth.JWT](i);if err!=nil{return nil,err}
		examples,err:=do.Invoke[*examplehandler.Handler](i);if err!=nil{return nil,err}
		return server.New(apiserver.NewRouter(configuration.HTTP,ready,logging,authentication,examples),configuration.HTTP,ready,logging)
	})
	httpServer,err := do.Invoke[*server.Server](injector)
	if err != nil { [[if ne .Database "none"]]_ = db.Close();[[end]] _ = logger.Sync(); return nil,err }
	return &App{Server:httpServer,Logger:logger,[[if ne .Database "none"]]Database:db[[end]]},nil
}

func (a *App) Run(ctx context.Context) error { defer func(){ [[if ne .Database "none"]]_ = a.Database.Close();[[end]] _ = a.Logger.Sync() }(); return a.Server.Run(ctx) }
