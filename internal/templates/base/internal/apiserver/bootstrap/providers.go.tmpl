	examplehandler "[[.Module]]/internal/apiserver/handler/http/example"
	[[if ne .Database "none"]]examplestore "[[.Module]]/internal/apiserver/store/example"[[end]]
	"[[.Module]]/internal/pkg/auth"
	"[[.Module]]/internal/pkg/config"
