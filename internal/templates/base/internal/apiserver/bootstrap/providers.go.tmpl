	"context"
	[[if or (ne .Database "none") .Redis (eq .Authz "casbin")]]"time"[[end]]

	"[[.Module]]/internal/apiserver"
	examplebiz "[[.Module]]/internal/apiserver/biz/example"
	examplehandler "[[.Module]]/internal/apiserver/handler/http/example"
	[[if eq .Transport "dual"]]rpchandler "[[.Module]]/internal/apiserver/handler/grpc/example"
	"[[.Module]]/internal/pkg/dual"
	"[[.Module]]/internal/pkg/rpc"[[end]]
	[[if ne .Database "none"]]examplestore "[[.Module]]/internal/apiserver/store/example"[[end]]
	"[[.Module]]/internal/pkg/auth"
	[[if eq .Authz "casbin"]]"[[.Module]]/internal/pkg/authz"[[end]]
	[[if .Redis]]"[[.Module]]/internal/pkg/cache"[[end]]
	"[[.Module]]/internal/pkg/config"
	[[if ne .Database "none"]]"[[.Module]]/internal/pkg/database"[[end]]
