package apiserver

import (
 "context"
 "encoding/base64"
 "net/http/httptest"
 "path/filepath"
 "testing"
 "time"

 biz "[[.Module]]/internal/apiserver/biz/example"
 handler "[[.Module]]/internal/apiserver/handler/http/example"
 store "[[.Module]]/internal/apiserver/store/example"
 "[[.Module]]/internal/pkg/auth"
 "[[.Module]]/internal/pkg/config"
 "[[.Module]]/internal/pkg/database"
 "[[.Module]]/internal/pkg/server"
 "go.uber.org/zap"
)
func TestReadinessReflectsDatabaseAndShutdown(t *testing.T){
 ctx:=context.Background();db,err:=database.Open(ctx,config.Database{Path:filepath.Join(t.TempDir(),"app.db"),MaxOpen:2,MaxIdle:1,BusyTimeout:time.Second,SlowThreshold:time.Second},zap.NewNop());if err!=nil{t.Fatal(err)};defer func(){_ = db.Close()}();if err:=db.Migrate(ctx);err!=nil{t.Fatal(err)}
 authentication,err:=auth.New(config.JWT{Secret:base64.StdEncoding.EncodeToString(make([]byte,32)),Issuer:"demo",Audience:"api",TTL:time.Minute});if err!=nil{t.Fatal(err)}
 ready:=&server.Readiness{CheckDependency:db.Pool.PingContext};router:=NewRouter(config.HTTP{MaxBodyBytes:1024,RequestTimeout:time.Second},ready,zap.NewNop(),authentication,handler.New(biz.New(store.New(db.DB))))
 check:=func(path string,status int){t.Helper();response:=httptest.NewRecorder();router.ServeHTTP(response,httptest.NewRequest("GET",path,nil));if response.Code!=status{t.Fatalf("%s status %d want %d",path,response.Code,status)}}
 check("/readyz",200);ready.Stop();check("/readyz",503);check("/healthz",200)
 otherReady:=&server.Readiness{CheckDependency:db.Pool.PingContext};router=NewRouter(config.HTTP{MaxBodyBytes:1024,RequestTimeout:time.Second},otherReady,zap.NewNop(),authentication,handler.New(biz.New(store.New(db.DB))))
 if err:=db.Close();err!=nil{t.Fatal(err)};check("/readyz",503);check("/healthz",200)
}
